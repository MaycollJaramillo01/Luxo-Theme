    <script type="application/json" data-variants>
      [
        {% for variant in landing_product.variants %}
          {
            "id": {{ variant.id | json }},
            "options": {{ variant.options | json }},
            "available": {{ variant.available | json }},
            "price": {{ variant.price | money | json }},
            "compare": {{ variant.compare_at_price | money | json }},
            "compareVisible": {% if variant.compare_at_price > variant.price %}true{% else %}false{% endif %},
            "inventory": {{ variant.inventory_quantity | default: 0 | json }},
            "inventoryManaged": {% if variant.inventory_management %}true{% else %}false{% endif %},
            "image": {% if variant.featured_media != blank %}{{ variant.featured_media.preview_image | image_url: width: 1800 | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    </script>

    <script>
      (() => {
        const root = document.getElementById('luxo-031-{{ section.id }}');
        if (!root || root.dataset.ready === 'true') return;
        root.dataset.ready = 'true';

        const variantData = root.querySelector('[data-variants]');
        const form = root.querySelector('.lx031-product-form');
        if (!variantData || !form) return;

        const variants = JSON.parse(variantData.textContent);
        const optionGroups = Array.from(root.querySelectorAll('[data-option-position]'));
        const variantId = root.querySelector('[data-variant-id]');
        const price = root.querySelector('[data-price]');
        const compare = root.querySelector('[data-compare]');
        const stock = root.querySelector('[data-stock]');
        const add = root.querySelector('[data-add]');
        const addText = root.querySelector('[data-add-text]');
        const mobilePrice = root.querySelector('[data-mobile-price]');
        const mobileAdd = root.querySelector('[data-mobile-add]');
        const mobileAddText = root.querySelector('[data-mobile-add-text]');
        const mainImage = root.querySelector('.lx031-main-image');
        const lowStockLimit = {{ section.settings.low_stock_limit | json }};
        const mobileLabel = {{ section.settings.mobile_button_label | json }};
        const soldOutLabel = {{ section.settings.sold_out_label | json }};

        const selectedOptions = () => optionGroups.map(group => {
          const checked = group.querySelector('[data-option-input]:checked');
          return checked ? checked.value : '';
        });

        const findVariant = options => variants.find(variant =>
          variant.options.every((value, index) => value === options[index])
        );

        const setMainImage = (src, alt) => {
          if (!mainImage || !src) return;
          mainImage.style.opacity = '0';
          window.setTimeout(() => {
            mainImage.src = src;
            mainImage.removeAttribute('srcset');
            if (alt) mainImage.alt = alt;
            mainImage.style.opacity = '1';
          }, 120);
        };

        const syncAvailability = options => {
          optionGroups.forEach((group, groupIndex) => {
            group.querySelectorAll('[data-option-input]').forEach(input => {
              const candidate = [...options];
              candidate[groupIndex] = input.value;
              const matching = findVariant(candidate);
              input.disabled = !matching || !matching.available;
            });
          });
        };

        const syncVariant = () => {
          const options = selectedOptions();
          const variant = findVariant(options);

          optionGroups.forEach(group => {
            const checked = group.querySelector('[data-option-input]:checked');
            const selected = group.querySelector('[data-option-selected]');
            if (checked && selected) selected.textContent = checked.value;
          });

          syncAvailability(options);

          if (!variant) {
            if (add) add.disabled = true;
            if (mobileAdd) mobileAdd.disabled = true;
            if (addText) addText.textContent = soldOutLabel;
            if (mobileAddText) mobileAddText.textContent = soldOutLabel;
            if (stock) stock.textContent = 'Esta combinación no está disponible.';
            return;
          }

          if (variantId) variantId.value = variant.id;
          if (price) price.textContent = variant.price;
          if (mobilePrice) mobilePrice.textContent = variant.price;

          if (compare) {
            compare.textContent = variant.compare || '';
            compare.hidden = !variant.compareVisible;
          }

          if (add) add.disabled = !variant.available;
          if (mobileAdd) mobileAdd.disabled = !variant.available;

          if (addText) {
            addText.textContent = variant.available
              ? `${add.dataset.label} - ${variant.price}`
              : add.dataset.soldOut;
          }

          if (mobileAddText) {
            mobileAddText.textContent = variant.available ? mobileLabel : soldOutLabel;
          }

          if (stock) {
            const low = variant.available && variant.inventoryManaged && variant.inventory > 0 && variant.inventory <= lowStockLimit;
            stock.dataset.lowStock = low ? 'true' : 'false';
            if (!variant.available) {
              stock.textContent = 'Esta combinación está agotada.';
            } else if (low) {
              stock.textContent = `Solo quedan ${variant.inventory} en esta combinación.`;
            } else {
              stock.textContent = 'Disponible para envío.';
            }
          }

          if (variant.image) setMainImage(variant.image, {{ landing_product.title | json }});

          if (window.history && window.history.replaceState) {
            const url = new URL(window.location.href);
            url.searchParams.set('variant', variant.id);
            window.history.replaceState({}, '', url.toString());
          }
        };

        root.querySelectorAll('[data-option-input]').forEach(input => {
          input.addEventListener('change', syncVariant);
        });

        root.querySelectorAll('[data-gallery-thumb]').forEach(thumb => {
          thumb.addEventListener('click', () => {
            root.querySelectorAll('[data-gallery-thumb]').forEach(item => item.setAttribute('aria-current', 'false'));
            thumb.setAttribute('aria-current', 'true');
            setMainImage(thumb.dataset.image, thumb.dataset.alt);
          });
        });

        syncVariant();
      })();
    </script>
  {% else %}
    <div class="lx031-shell lx031-section">
      <div class="lx031-empty">
        <div>
          <h2>Selecciona la Faja 031</h2>
          <p>Abre esta sección en el editor del theme y elige el producto que debe mostrarse.</p>
        </div>
      </div>
    </div>
  {% endif %}
</section>

