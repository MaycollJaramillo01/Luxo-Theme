{{ 'luxo-landing.css' | asset_url | stylesheet_tag }}

<section
  class="luxo-block"
  style="
    --lb-bg: {{ section.settings.bg_color }};
    --lb-surface: {{ section.settings.surface_color }};
    --lb-text: {{ section.settings.text_color }};
    --lb-muted: {{ section.settings.muted_color }};
    --lb-accent: {{ section.settings.accent_color }};
    --lb-max: {{ section.settings.page_width }}px;
    --lb-radius: {{ section.settings.card_radius }}px;
    --lb-section-space: {{ section.settings.section_spacing }}px;
  "
>
  <div class="lb-section">
    <div class="lb-wrap">
      <div class="lb-guarantee">
        {% if section.settings.title != blank %}
          <h3 class="lb-guarantee-title">{{ section.settings.title }}</h3>
        {% endif %}
        {% if section.settings.text != blank %}
          <p class="lb-guarantee-text">{{ section.settings.text }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luxo - Garantía",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "COMPRA SIN RIESGO"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Texto",
      "default": "Pruébala por 7 días. Si no te encanta cómo te hace ver, te devolvemos tu dinero."
    },
    {
      "type": "range",
      "id": "page_width",
      "label": "Ancho máximo",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "range",
      "id": "section_spacing",
      "label": "Espaciado",
      "min": 40,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Radio",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo",
      "default": "#f7f4ef"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "Tarjeta",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#181511"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Texto secundario",
      "default": "#6f675d"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Acento",
      "default": "#b89057"
    }
  ],
  "presets": [
    {
      "name": "Luxo - Garantía"
    }
  ]
}
{% endschema %}