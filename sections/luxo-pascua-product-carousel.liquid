{% comment %}
  File: sections/luxo-pascua-product-carousel.liquid
  Versión: Carrusel Infinito de Productos - Campaña Pascua
  - Diseño limpio y minimalista.
  - Efecto "Marquee" infinito con CSS puro (sin JavaScript pesado).
  - Pausa al hacer hover para permitir clics en los productos.
  - Selector de colección dinámica en Shopify.
{% endcomment %}

<section class="lux-product-carousel luxe--{{ section.id }}">
  <style>
    .luxe--{{ section.id }} {
      --lux-bg: {{ section.settings.bg_color }};
      --lux-text: {{ section.settings.text_color }};
      --lux-pt: {{ section.settings.padding_top }}px;
      --lux-pb: {{ section.settings.padding_bottom }}px;
      --lux-speed: {{ section.settings.carousel_speed }}s;
    }

    .lux-product-carousel {
      background-color: var(--lux-bg);
      color: var(--lux-text);
      padding-top: var(--lux-pt);
      padding-bottom: var(--lux-pb);
      overflow: hidden;
      font-family: inherit;
      display: block;
    }

    .lux-pc-header {
      text-align: center;
      margin-bottom: 40px;
      padding: 0 24px;
    }

    .lux-pc-kicker {
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 16px;
      opacity: 0.7;
    }

    .lux-pc-title {
      font-size: clamp(24px, 4vw, 40px);
      font-weight: 400;
      letter-spacing: -0.01em;
      margin: 0;
      text-transform: uppercase;
    }

    /* Contenedor principal del carrusel */
    .lux-pc-marquee {
      display: flex;
      width: 100%;
      overflow: hidden;
      white-space: nowrap;
      position: relative;
    }

    /* Pausa la animación al pasar el ratón para poder hacer clic */
    .lux-pc-marquee:hover .lux-pc-track {
      animation-play-state: paused;
    }

    /* Pista que se duplica para el efecto infinito */
    .lux-pc-track {
      display: flex;
      flex-shrink: 0;
      align-items: stretch;
      animation: scrollProducts var(--lux-speed) linear infinite;
      padding-left: 24px;
    }

    @keyframes scrollProducts {
      0% { transform: translateX(0); }
      100% { transform: translateX(-100%); }
    }

    /* Tarjeta de Producto */
    .lux-pc-card {
      display: inline-flex;
      flex-direction: column;
      width: 280px;
      margin-right: 24px;
      text-decoration: none;
      color: inherit;
      white-space: normal; /* Para que el texto baje de línea si es largo */
      transition: opacity 0.3s ease;
    }

    .lux-pc-card:hover {
      opacity: 0.8;
    }

    .lux-pc-image {
      width: 100%;
      aspect-ratio: 3/4;
      background-color: #f4f4f4;
      overflow: hidden;
      margin-bottom: 16px;
    }

    .lux-pc-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .lux-pc-info {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .lux-pc-product-title {
      font-size: 14px;
      font-weight: 500;
      margin: 0;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      line-height: 1.4;
    }

    .lux-pc-price {
      font-size: 14px;
      font-weight: 400;
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .lux-pc-compare {
      text-decoration: line-through;
      opacity: 0.5;
      font-size: 12px;
    }

    .lux-pc-current {
      color: var(--lux-text);
    }
    
    .lux-pc-current.sale {
      color: #b30000; /* Color rojo para precio en descuento (puedes cambiarlo) */
      font-weight: 500;
    }

    /* Mobile Responsive */
    @media (max-width: 768px) {
      .luxe--{{ section.id }} {
        --lux-pt: {{ section.settings.padding_top | divided_by: 1.5 }}px;
        --lux-pb: {{ section.settings.padding_bottom | divided_by: 1.5 }}px;
      }
      .lux-pc-card {
        width: 220px; /* Tarjetas más pequeñas en móviles */
        margin-right: 16px;
      }
      .lux-pc-track {
        padding-left: 16px;
      }
    }
  </style>

  <div class="lux-pc-header">
    {% if section.settings.kicker != blank %}
      <div class="lux-pc-kicker">{{ section.settings.kicker }}</div>
    {% endif %}
    
    {% if section.settings.title != blank %}
      <h2 class="lux-pc-title">{{ section.settings.title }}</h2>
    {% endif %}
  </div>

  <div class="lux-pc-marquee">
    {% assign easter_collection = collections[section.settings.collection] %}
    
    {% comment %} Capturamos los productos en una variable para poder duplicar la pista fácilmente {% endcomment %}
    {% capture product_items %}
      {% if easter_collection != blank and easter_collection.products_count > 0 %}
        {% for product in easter_collection.products limit: section.settings.product_limit %}
          <a href="{{ product.url }}" class="lux-pc-card">
            <div class="lux-pc-image">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title | escape }}" loading="lazy">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
            
            <div class="lux-pc-info">
              <h3 class="lux-pc-product-title">{{ product.title }}</h3>
              <div class="lux-pc-price">
                {% if product.compare_at_price > product.price %}
                  <s class="lux-pc-compare">{{ product.compare_at_price | money }}</s>
                  <span class="lux-pc-current sale">{{ product.price | money }}</span>
                {% else %}
                  <span class="lux-pc-current">{{ product.price | money }}</span>
                {% endif %}
              </div>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% comment %} Placeholder si no hay colección seleccionada {% endcomment %}
        {% for i in (1..6) %}
          <div class="lux-pc-card">
            <div class="lux-pc-image">
              {{ 'product-' | append: i | placeholder_svg_tag }}
            </div>
            <div class="lux-pc-info">
              <h3 class="lux-pc-product-title">Producto de Pascua {{ i }}</h3>
              <div class="lux-pc-price">
                <span class="lux-pc-current">$99.00</span>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    {% endcapture %}

    {% comment %} Imprimimos la pista 2 veces para crear la ilusión óptica del scroll infinito {% endcomment %}
    <div class="lux-pc-track">
      {{ product_items }}
    </div>
    <div class="lux-pc-track" aria-hidden="true">
      {{ product_items }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Carrusel Productos Pascua",
  "settings": [
    {
      "type": "header",
      "content": "Textos de la sección"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Antetítulo",
      "default": "NUESTRAS FAVORITAS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "EASTER SALE"
    },
    {
      "type": "header",
      "content": "Productos"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección a mostrar"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Límite de productos",
      "min": 4,
      "max": 15,
      "step": 1,
      "default": 8,
      "info": "Recomendamos al menos 6 productos para un buen efecto infinito."
    },
    {
      "type": "range",
      "id": "carousel_speed",
      "label": "Velocidad del carrusel",
      "min": 10,
      "max": 60,
      "step": 2,
      "default": 20,
      "unit": "s",
      "info": "Menos segundos = más rápido."
    },
    {
      "type": "header",
      "content": "Diseño y Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding superior",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding inferior",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 80,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Carrusel Productos Pascua",
      "category": "Productos"
    }
  ]
}
{% endschema %}