{% comment %}
  ============================================================
  SECTION: Suscripciones
  Muestra los productos de una colección como planes mensuales.
  Edita todo desde Personalizar tema.
  ============================================================
{% endcomment %}

{%- liquid
  assign coll = collections[section.settings.collection]
  assign limit = section.settings.products_limit
-%}

<section
  class="sub-section"
  style="
    --sub-bg: {{ section.settings.bg_color }};
    --sub-text: {{ section.settings.text_color }};
    --sub-accent: {{ section.settings.accent_color }};
    --sub-card-bg: {{ section.settings.card_bg_color }};
    --sub-radius: {{ section.settings.card_radius }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="sub-container">

    {%- if section.settings.badge != blank -%}
      <span class="sub-badge">{{ section.settings.badge }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="sub-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="sub-subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="sub-benefits">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            <li class="sub-benefit" {{ block.shopify_attributes }}>
              <span class="sub-benefit-icon" aria-hidden="true">✓</span>
              {{ block.settings.text }}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if coll and coll.products.size > 0 -%}
      <div class="sub-grid">
        {%- for product in coll.products limit: limit -%}
          <article class="sub-card">
            {%- liquid
              assign sub_variant = product.selected_or_first_available_variant
              assign has_sub = false
              if sub_variant.selling_plan_allocations.size > 0
                assign has_sub = true
              endif
            -%}
            <a href="{{ product.url }}" class="sub-card-link" aria-label="{{ product.title | escape }}">

              {%- if product.featured_image -%}
                <div class="sub-card-media">
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    srcset="{{ product.featured_image | image_url: width: 300 }} 300w,
                            {{ product.featured_image | image_url: width: 600 }} 600w,
                            {{ product.featured_image | image_url: width: 900 }} 900w"
                    sizes="(max-width: 749px) 90vw, 30vw"
                    alt="{{ product.featured_image.alt | escape | default: product.title | escape }}"
                    width="600"
                    height="600"
                    loading="lazy"
                  >
                  {%- if section.settings.show_frequency -%}
                    <span class="sub-freq">{{ section.settings.frequency_label }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="sub-card-body">
                <h3 class="sub-card-title">{{ product.title }}</h3>

                {%- if section.settings.show_description and product.description != blank -%}
                  <p class="sub-card-desc">
                    {{ product.description | strip_html | truncatewords: 18 }}
                  </p>
                {%- endif -%}

                <div class="sub-card-price">
                  {%- if has_sub -%}
                    {%- comment -%}
                      El precio tachado = precio regular del producto multiplicado por
                      la posición del plan en la lista (1er plan = 1 unidad, 2do = 2, etc.),
                      ya que los planes están ordenados por cantidad de unidades.
                      Esto muestra lo que costaría comprar esa cantidad a precio normal.
                    {%- endcomment -%}
                    {%- liquid
                      if product.compare_at_price > product.price
                        assign regular_price = product.compare_at_price
                      else
                        assign regular_price = product.price
                      endif
                    -%}
                    <div class="sub-plan-grid">
                      {%- for alloc in sub_variant.selling_plan_allocations -%}
                        {%- assign plan_label = alloc.selling_plan.name | split: ',' | first | strip -%}
                        {%- assign full_price = regular_price | times: forloop.index -%}
                        <div class="sub-plan{% if forloop.first %} is-best{% endif %}">
                          {%- if forloop.first and sub_variant.selling_plan_allocations.size > 1 -%}
                            <span class="sub-plan-tag">Más popular</span>
                          {%- endif -%}
                          <span class="sub-plan-name">{{ plan_label | default: 'Suscripción mensual' }}</span>
                          <span class="sub-plan-price">
                            {{ alloc.per_delivery_price | money }}
                            {%- if full_price > alloc.per_delivery_price -%}
                              <span class="sub-plan-compare">{{ full_price | money }}</span>
                            {%- endif -%}
                          </span>
                        </div>
                      {%- endfor -%}
                    </div>
                  {%- else -%}
                    <div class="sub-price-row">
                      <span class="sub-price-now">{{ product.price | money }}</span>
                      {%- if product.compare_at_price > product.price -%}
                        <span class="sub-price-compare">{{ product.compare_at_price | money }}</span>
                      {%- endif -%}
                    </div>
                    {%- if section.settings.show_per_month -%}
                      <span class="sub-price-period">Compra única</span>
                    {%- endif -%}
                  {%- endif -%}
                </div>

                <span class="sub-card-cta">{{ section.settings.button_label }}</span>
              </div>
            </a>
          </article>
        {%- endfor -%}
      </div>

      {%- if section.settings.show_view_all and coll.products.size > limit -%}
        <div class="sub-viewall-wrap">
          <a href="{{ coll.url }}" class="sub-viewall">{{ section.settings.view_all_label }}</a>
        </div>
      {%- endif -%}

    {%- else -%}
      <div class="sub-empty">
        {%- if coll == blank -%}
          <p>Selecciona una colección en Personalizar tema.</p>
        {%- else -%}
          <p>Esta colección aún no tiene productos.</p>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .sub-section {
    background: var(--sub-bg);
    color: var(--sub-text);
  }
  .sub-container {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
    text-align: center;
  }
  .sub-badge {
    display: inline-block;
    background: var(--sub-accent);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 16px;
  }
  .sub-heading {
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.1;
    margin: 0 0 12px;
    font-weight: 800;
  }
  .sub-subheading {
    font-size: clamp(15px, 1.8vw, 18px);
    max-width: 640px;
    margin: 0 auto 28px;
    opacity: .8;
  }
  .sub-benefits {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    justify-content: center;
    padding: 0;
    margin: 0 0 40px;
  }
  .sub-benefit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
  }
  .sub-benefit-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--sub-accent);
    color: #fff;
    font-size: 12px;
    flex-shrink: 0;
  }
  .sub-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .sub-card {
    background: var(--sub-card-bg);
    border-radius: var(--sub-radius);
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,.06);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .sub-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 28px rgba(0,0,0,.12);
  }
  .sub-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }
  .sub-card-media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .sub-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .sub-freq {
    position: absolute;
    top: 12px;
    left: 12px;
    max-width: calc(100% - 24px);
    background: rgba(0,0,0,.7);
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .05em;
    padding: 5px 10px;
    border-radius: 999px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sub-card-body {
    padding: 18px 18px 22px;
    text-align: left;
  }
  .sub-card-title {
    font-size: 17px;
    font-weight: 700;
    margin: 0 0 8px;
  }
  .sub-card-desc {
    font-size: 13px;
    opacity: .7;
    margin: 0 0 14px;
    line-height: 1.5;
  }
  .sub-card-price {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 16px;
  }
  .sub-plan-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sub-plan {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    padding: 12px 14px;
    border: 1px solid rgba(0,0,0,.12);
    border-radius: 12px;
    background: rgba(0,0,0,.015);
  }
  .sub-plan.is-best {
    border-color: var(--sub-accent);
    background: color-mix(in srgb, var(--sub-accent) 6%, transparent);
  }
  .sub-plan-tag {
    position: absolute;
    top: -9px;
    right: 12px;
    background: var(--sub-accent);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 999px;
  }
  .sub-plan-name {
    font-size: 13px;
    font-weight: 600;
    opacity: .85;
    line-height: 1.3;
  }
  .sub-plan-price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 22px;
    font-weight: 800;
    color: var(--sub-accent);
    line-height: 1.15;
  }
  .sub-plan-compare {
    font-size: 13px;
    font-weight: 400;
    text-decoration: line-through;
    opacity: .45;
    color: var(--sub-text);
  }
  .sub-price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sub-price-compare {
    text-decoration: line-through;
    opacity: .5;
    font-size: 14px;
    font-weight: 400;
    white-space: nowrap;
  }
  .sub-price-now {
    font-size: 24px;
    font-weight: 800;
    color: var(--sub-accent);
    line-height: 1.1;
    white-space: nowrap;
  }
  .sub-price-period {
    font-size: 12px;
    opacity: .6;
    text-transform: capitalize;
  }
  .sub-card-cta {
    display: block;
    text-align: center;
    background: var(--sub-accent);
    color: #fff;
    font-weight: 700;
    font-size: 14px;
    padding: 12px;
    border-radius: 10px;
  }
  .sub-viewall-wrap {
    margin-top: 36px;
  }
  .sub-viewall {
    display: inline-block;
    border: 2px solid var(--sub-accent);
    color: var(--sub-accent);
    font-weight: 700;
    text-decoration: none;
    padding: 12px 28px;
    border-radius: 10px;
    transition: background .2s ease, color .2s ease;
  }
  .sub-viewall:hover {
    background: var(--sub-accent);
    color: #fff;
  }
  .sub-empty {
    padding: 40px;
    opacity: .6;
  }
  @media (max-width: 989px) {
    .sub-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 749px) {
    .sub-grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Suscripciones",
  "tag": "section",
  "class": "section-subscriptions",
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Etiqueta superior",
      "default": "Membresía mensual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Recíbelo cada mes en tu puerta"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Suscríbete una vez y recibe tus productos favoritos automáticamente cada mes, con descuento exclusivo de miembros."
    },
    {
      "type": "header",
      "content": "Colección"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección de suscripciones"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Máximo de productos",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Mostrar descripción corta",
      "default": true
    },
    {
      "type": "header",
      "content": "Frecuencia y precio"
    },
    {
      "type": "checkbox",
      "id": "show_frequency",
      "label": "Mostrar etiqueta de frecuencia",
      "default": true
    },
    {
      "type": "text",
      "id": "frequency_label",
      "label": "Texto de frecuencia",
      "default": "Cada mes"
    },
    {
      "type": "checkbox",
      "id": "show_per_month",
      "label": "Mostrar \"/ mes\" junto al precio",
      "default": true
    },
    {
      "type": "header",
      "content": "Botones"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón de producto",
      "default": "Suscribirme"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Mostrar botón \"Ver todo\"",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Texto \"Ver todo\"",
      "default": "Ver todos los planes"
    },
    {
      "type": "header",
      "content": "Estilo"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo de la sección",
      "default": "#F7F5F2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color de acento",
      "default": "#2E7D5B"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Fondo de tarjeta",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Redondeo de tarjeta",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto del beneficio",
          "default": "Envío gratis cada mes"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Suscripciones",
      "blocks": [
        { "type": "benefit", "settings": { "text": "Envío gratis cada mes" } },
        { "type": "benefit", "settings": { "text": "Cancela cuando quieras" } },
        { "type": "benefit", "settings": { "text": "Precio exclusivo de miembros" } }
      ]
    }
  ]
}
{% endschema %}
