{%- comment -%}
  Colecciones similares: imagen grande + botón tipo pastilla.
  Lee la imagen de la colección (o la del primer producto) y nunca inventa datos.
{%- endcomment -%}

{%- liquid
  assign visible_blocks = 0
  for block in section.blocks
    if block.settings.collection != blank or block.settings.image != blank
      assign visible_blocks = visible_blocks | plus: 1
    endif
  endfor
-%}

{%- if visible_blocks > 0 -%}
  <section
    class="luxo-section luxo-related-collections"
    style="--luxo-rc-cols: {{ section.settings.columns | default: 2 }}; --luxo-rc-ratio: {{ section.settings.ratio }};"
  >
    <div class="luxo-container luxo-container--wide">
      {%- if section.settings.heading != blank or section.settings.kicker != blank -%}
        <header class="luxo-related-collections__head">
          {%- if section.settings.kicker != blank -%}<p class="luxo-kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.copy != blank -%}<p>{{ section.settings.copy | escape }}</p>{%- endif -%}
        </header>
      {%- endif -%}

      <ul class="luxo-related-collections__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign rc_collection = block.settings.collection
            assign rc_url = block.settings.link | default: rc_collection.url
            assign rc_label = block.settings.label | default: rc_collection.title

            assign rc_image = block.settings.image
            if rc_image == blank
              assign rc_image = rc_collection.image
            endif
            if rc_image == blank
              assign rc_image = rc_collection.products.first.featured_media.preview_image
            endif
          -%}

          {%- if rc_url != blank -%}
            <li {{ block.shopify_attributes }}>
              <a class="luxo-rc-card luxo-rc-card--{{ section.settings.label_position }}" href="{{ rc_url }}">
                {%- if rc_image != blank -%}
                  {{ rc_image | image_url: width: 1400 | image_tag:
                    widths: '480, 720, 1000, 1400',
                    sizes: '(max-width: 600px) 92vw, (max-width: 899px) 46vw, 46vw',
                    loading: 'lazy',
                    alt: rc_label
                  }}
                {%- endif -%}
                <span class="luxo-rc-card__label">{{ rc_label | escape }}</span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="luxo-section luxo-related-collections">
    <div class="luxo-container luxo-container--wide">
      <p style="padding: 14px 18px; border: 1px dashed var(--luxo-line); color: var(--luxo-ink-soft);">
        Agrega bloques y elige una colección en cada uno para mostrar las colecciones similares.
      </p>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Colecciones similares",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "TAMBIÉN PARA TI" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Colecciones similares" },
    { "type": "text", "id": "copy", "label": "Texto de apoyo" },
    { "type": "range", "id": "columns", "label": "Columnas en escritorio", "min": 2, "max": 4, "step": 1, "default": 2 },
    {
      "type": "select",
      "id": "ratio",
      "label": "Proporción de la imagen",
      "default": "16 / 11",
      "options": [
        { "value": "16 / 11", "label": "Panorámica" },
        { "value": "4 / 3", "label": "Clásica" },
        { "value": "1 / 1", "label": "Cuadrada" },
        { "value": "4 / 5", "label": "Vertical" }
      ]
    },
    {
      "type": "select",
      "id": "label_position",
      "label": "Posición del botón",
      "default": "bottom",
      "options": [
        { "value": "top", "label": "Arriba" },
        { "value": "center", "label": "Centro" },
        { "value": "bottom", "label": "Abajo" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Colección",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "image_picker", "id": "image", "label": "Imagen alternativa", "info": "Vacío usa la imagen de la colección." },
        { "type": "text", "id": "label", "label": "Texto del botón", "info": "Vacío usa el nombre de la colección." },
        { "type": "url", "id": "link", "label": "Enlace alternativo" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Colecciones similares",
      "blocks": [{ "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
