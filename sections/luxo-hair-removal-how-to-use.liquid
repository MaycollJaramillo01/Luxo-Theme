{{ 'luxo-hair-removal-campaign.css' | asset_url | stylesheet_tag }}

<section
  class="lxhr"
  style="
    --lxhr-bg: {{ section.settings.bg_color }};
    --lxhr-surface: {{ section.settings.surface_color }};
    --lxhr-text: {{ section.settings.text_color }};
    --lxhr-muted: {{ section.settings.muted_color }};
    --lxhr-border: {{ section.settings.border_color }};
    --lxhr-accent: {{ section.settings.accent_color }};
    --lxhr-accent-soft: {{ section.settings.accent_soft_color }};
    --lxhr-radius: {{ section.settings.radius }}px;
    --lxhr-max: {{ section.settings.page_width }}px;
    --lxhr-space: {{ section.settings.section_spacing }}px;
  "
>
  <div class="lxhr-wrap">
    <div class="lxhr-section">
      <div class="lxhr-center">
        {% if section.settings.eyebrow != blank %}
          <div class="lxhr-eyebrow">{{ section.settings.eyebrow }}</div>
        {% endif %}
        <h2 class="lxhr-title">{{ section.settings.title }}</h2>
        {% if section.settings.subtitle != blank %}
          <div class="lxhr-subtitle">{{ section.settings.subtitle }}</div>
        {% endif %}
      </div>

      <div class="lxhr-steps">
        {% for block in section.blocks %}
          <div class="lxhr-card" {{ block.shopify_attributes }}>
            <div class="lxhr-step-number">{{ forloop.index }}</div>
            <h3 class="lxhr-card-title">{{ block.settings.title }}</h3>
            <div class="lxhr-card-text">{{ block.settings.text }}</div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luxo Hair Removal",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Proceso"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Cómo presentar el uso del producto"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Ajusta estos textos de acuerdo con las instrucciones reales de tu producto. No dejes pasos inventados."
    },
    {
      "type": "range",
      "id": "page_width",
      "label": "Ancho máximo",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1240
    },
    {
      "type": "range",
      "id": "section_spacing",
      "label": "Espaciado",
      "min": 40,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Radio",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo",
      "default": "#fbf5f4"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "Tarjeta",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto principal",
      "default": "#1b1718"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Texto secundario",
      "default": "#6d6265"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Acento",
      "default": "#d7c56f"
    },
    {
      "type": "color",
      "id": "accent_soft_color",
      "label": "Acento suave",
      "default": "#d8e7af"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borde",
      "default": "#eadfdf"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Paso"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "default": "Describe este paso según la guía real de uso del producto."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxo Hair Removal How To Use",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Aplica el producto",
            "text": "Coloca una capa uniforme en la zona indicada siguiendo la guía real del producto."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Espera el tiempo recomendado",
            "text": "Respeta únicamente el tiempo indicado por la marca o por el empaque del producto."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Retira y limpia",
            "text": "Retira el producto según las instrucciones reales y limpia la zona con cuidado."
          }
        }
      ]
    }
  ]
}
{% endschema %}