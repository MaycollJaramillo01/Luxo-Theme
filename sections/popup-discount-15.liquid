    {
      "type": "text",
      "id": "success_title",
      "label": "Éxito · Título",
      "default": "CHECK YOUR EMAIL"
    },
    {
      "type": "textarea",
      "id": "success_text",
      "label": "Éxito · Texto",
      "default": "Your 15% discount code is on its way."
    }
  ],
  "presets": [
    {
      "name": "Popup discount 15%"
    }
  ]
}
{% endschema %}
