      "max": 15,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "hide_days",
      "label": "Ocultar por días al cerrar o enviar",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 7
    },
    {
      "type": "text",
      "id": "step1_eyebrow",
      "label": "Paso 1 · Eyebrow",
      "default": "YOU'VE GOT"
    },
    {
      "type": "text",
      "id": "step1_title",
      "label": "Paso 1 · Título",
      "default": "15% OFF"
    },
    {
      "type": "textarea",
      "id": "step1_text",
      "label": "Paso 1 · Texto",
      "default": "To claim your discount, tell us:\nWhat's your preference?"
    },
    {
      "type": "text",
      "id": "label_women",
      "label": "Botón 1",
      "default": "Women"
    },
    {
      "type": "text",
      "id": "label_men",
      "label": "Botón 2",
      "default": "Men"
    },
    {
      "type": "text",
      "id": "label_both",
      "label": "Botón 3",
      "default": "Both"
    },
    {
      "type": "text",
      "id": "step2_eyebrow",
      "label": "Paso 2 · Eyebrow",
      "default": "SIGN UP TO UNLOCK"
    },
    {
      "type": "text",
      "id": "step2_title",
      "label": "Paso 2 · Título",
      "default": "15% OFF"
    },
    {
      "type": "textarea",
      "id": "step2_text",
      "label": "Paso 2 · Texto",
      "default": "Enter your email address to receive your discount code for:"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Placeholder email",
      "default": "Enter your email address"
