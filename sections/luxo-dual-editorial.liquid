<script>
(function () {
  var root = document.getElementById("{{ section_id }}");
  if (!root) return;

  root.querySelectorAll("[data-product-card]").forEach(function (card) {
    var variantData = [];
    try { variantData = JSON.parse(card.querySelector("[data-variant-json]").textContent); } catch (e) { return; }

    var triggers = card.querySelectorAll("[data-variant-trigger]");
    var mainImg  = card.querySelector("[data-main-image]");
    var varIdEl  = card.querySelector("[data-variant-id]");
    var atcBtn   = card.querySelector("[data-atc-btn]");

    function getSelected() {
      var sel = {};
      triggers.forEach(function (t) {
        if (t.classList.contains("active")) sel[t.getAttribute("data-variant-trigger")] = t.getAttribute("data-variant-value");
      });
      return sel;
    }

    function findVariant(sel) {
      return variantData.find(function (v) {
        return Object.keys(sel).every(function (pos) { return v.options[parseInt(pos) - 1] === sel[pos]; });
      });
    }

    function updateCard(variant) {
      if (!variant) return;
      if (varIdEl) varIdEl.value = variant.id;
      if (atcBtn) {
        atcBtn.setAttribute("data-variant-id", variant.id);
        atcBtn.disabled = !variant.available;
        atcBtn.classList.toggle("ld__btn--disabled", !variant.available);
      }
      if (mainImg && variant.featured_image) mainImg.src = variant.featured_image;
    }

    triggers.forEach(function (trigger) {
      trigger.addEventListener("click", function () {
        var pos = trigger.getAttribute("data-variant-trigger");
        card.querySelectorAll("[data-variant-trigger='" + pos + "']").forEach(function (t) { t.classList.remove("active"); });
        trigger.classList.add("active");
        updateCard(findVariant(getSelected()));
      });
    });
  });

  root.addEventListener("click", function (e) {
    var btn = e.target.closest("[data-atc-btn]");
    if (!btn || btn.disabled) return;
    var id = btn.getAttribute("data-variant-id");
    if (!id) return;
    var original = btn.textContent;
    btn.textContent = "Agregando...";
    fetch("/cart/add.js", {
      method: "POST",
      headers: { "Content-Type": "application/json", "X-Requested-With": "XMLHttpRequest" },
      body: JSON.stringify({ id: id, quantity: 1 })
    })
    .then(function (r) { return r.json(); })
    .then(function () {
      btn.textContent = "Agregado!";
      document.dispatchEvent(new CustomEvent("cart:refresh"));
      setTimeout(function () { btn.textContent = original; }, 2000);
    })
    .catch(function () { btn.textContent = "Error - intenta de nuevo"; setTimeout(function () { btn.textContent = original; }, 2500); });
  });
})();
</script>

