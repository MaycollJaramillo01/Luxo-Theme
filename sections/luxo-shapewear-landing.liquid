{% liquid
  assign trust_blocks = section.blocks | where: 'type', 'trust_item'
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
  assign product_blocks = section.blocks | where: 'type', 'product_card'
  assign testimonial_blocks = section.blocks | where: 'type', 'testimonial'

  assign promo_collection = section.settings.promo_collection
  assign use_collection_products = false

  if promo_collection != blank and promo_collection.products_count > 0
    assign use_collection_products = true
  endif

  assign resolved_products_title = section.settings.products_title
  if section.settings.use_collection_title and promo_collection != blank and promo_collection.title != blank
    assign resolved_products_title = promo_collection.title
  endif

  assign resolved_products_link = section.settings.products_link_url
  if resolved_products_link == blank and promo_collection != blank
    assign resolved_products_link = promo_collection.url
  endif

  assign products_anchor = '#lb-products-' | append: section.id

  assign hero_primary_href = section.settings.hero_primary_url
  if hero_primary_href == blank and promo_collection != blank
    assign hero_primary_href = promo_collection.url
  endif
  if hero_primary_href == blank
    assign hero_primary_href = products_anchor
  endif

  assign contact_fallback_href = section.settings.header_cta_url

  assign hero_secondary_href = section.settings.hero_secondary_url
  if hero_secondary_href == blank and contact_fallback_href != blank
    assign hero_secondary_href = contact_fallback_href
  endif
  if hero_secondary_href == blank
    assign hero_secondary_href = products_anchor
  endif

  assign final_primary_href = section.settings.final_primary_url
  if final_primary_href == blank
    assign final_primary_href = hero_primary_href
  endif

  assign final_secondary_href = section.settings.final_secondary_url
  if final_secondary_href == blank and contact_fallback_href != blank
    assign final_secondary_href = contact_fallback_href
  endif
  if final_secondary_href == blank
    assign final_secondary_href = products_anchor
  endif

  assign collection_cta_primary_href = section.settings.collection_cta_primary_url
  if collection_cta_primary_href == blank
    assign collection_cta_primary_href = hero_primary_href
  endif

  assign collection_cta_secondary_href = section.settings.collection_cta_secondary_url
  if collection_cta_secondary_href == blank and contact_fallback_href != blank
    assign collection_cta_secondary_href = contact_fallback_href
  endif
  if collection_cta_secondary_href == blank
    assign collection_cta_secondary_href = products_anchor
  endif

  assign sticky_mobile_href = section.settings.sticky_mobile_url
  if sticky_mobile_href == blank
    assign sticky_mobile_href = hero_primary_href
  endif

  assign collection_description = ''
  if promo_collection != blank and promo_collection.description != blank
    assign collection_description = promo_collection.description | strip_html | truncate: 220
  endif
%}

<section
  id="luxo-landing-{{ section.id }}"
  class="luxo-landing"
  style="
    --lb-bg: {{ section.settings.bg_color }};
    --lb-surface: {{ section.settings.surface_color }};
    --lb-alt: {{ section.settings.alt_bg_color }};
    --lb-text: {{ section.settings.text_color }};
    --lb-muted: {{ section.settings.muted_color }};
    --lb-accent: {{ section.settings.accent_color }};
    --lb-dark: {{ section.settings.dark_color }};
    --lb-border: {{ section.settings.border_color }};
    --lb-max: {{ section.settings.page_width }}px;
    --lb-radius: {{ section.settings.card_radius }}px;
    --lb-section-space: {{ section.settings.section_spacing }}px;
    --lb-outer-top: {{ section.settings.padding_top }}px;
    --lb-outer-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <style>
    #luxo-landing-{{ section.id }} {
      position: relative;
      overflow: hidden;
      background: var(--lb-bg);
      color: var(--lb-text);
      padding-top: var(--lb-outer-top);
      padding-bottom: var(--lb-outer-bottom);
    }

    #luxo-landing-{{ section.id }} * {
      box-sizing: border-box;
    }

    #luxo-landing-{{ section.id }} a {
      color: inherit;
    }

    #luxo-landing-{{ section.id }} .lb-wrap {
      width: 100%;
      max-width: var(--lb-max);
      margin: 0 auto;
      padding-left: 24px;
      padding-right: 24px;
    }

    #luxo-landing-{{ section.id }} .lb-section {
      padding-top: var(--lb-section-space);
      padding-bottom: var(--lb-section-space);
    }

    #luxo-landing-{{ section.id }} .lb-alt {
      background: var(--lb-alt);
    }

    #luxo-landing-{{ section.id }} .lb-rte p {
      margin: 0 0 12px;
    }

    #luxo-landing-{{ section.id }} .lb-rte p:last-child {
      margin-bottom: 0;
    }

    #luxo-landing-{{ section.id }} .lb-notice {
      background: var(--lb-dark);
      color: #fff;
      border-bottom: 1px solid rgba(255,255,255,.08);
    }

    #luxo-landing-{{ section.id }} .lb-notice-inner {
      min-height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-size: 11px;
      line-height: 1.5;
      letter-spacing: .12em;
      text-transform: uppercase;
      padding-top: 10px;
      padding-bottom: 10px;
    }

    #luxo-landing-{{ section.id }} .lb-title,
    #luxo-landing-{{ section.id }} .lb-hero-title,
    #luxo-landing-{{ section.id }} .lb-card-title,
    #luxo-landing-{{ section.id }} .lb-brand,
    #luxo-landing-{{ section.id }} .lb-dark-title,
    #luxo-landing-{{ section.id }} .lb-float-card-title,
    #luxo-landing-{{ section.id }} .lb-quote,
    #luxo-landing-{{ section.id }} .lb-collection-cta-title {
      font-family: Georgia, "Times New Roman", serif;
    }

    #luxo-landing-{{ section.id }} .lb-inner-header {
      position: sticky;
      top: 0;
      z-index: 20;
      background: rgba(247,244,239,.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--lb-border);
    }

    #luxo-landing-{{ section.id }} .lb-header-row {
      min-height: 74px;
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 18px;
      align-items: center;
    }

    #luxo-landing-{{ section.id }} .lb-brand {
      font-size: 18px;
      line-height: 1.1;
      letter-spacing: .01em;
      white-space: nowrap;
    }

    #luxo-landing-{{ section.id }} .lb-header-center {
      min-width: 0;
      display: flex;
      justify-content: center;
    }

    #luxo-landing-{{ section.id }} .lb-header-micro {
      font-size: 11px;
      line-height: 1.5;
      color: var(--lb-muted);
      text-align: center;
    }

    #luxo-landing-{{ section.id }} .lb-header-right {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 12px;
    }

    #luxo-landing-{{ section.id }} .lb-menu-link,
    #luxo-landing-{{ section.id }} .lb-footer-link,
    #luxo-landing-{{ section.id }} .lb-see-all {
      text-decoration: none;
      color: var(--lb-muted);
      transition: .25s ease;
    }

    #luxo-landing-{{ section.id }} .lb-menu-link:hover,
    #luxo-landing-{{ section.id }} .lb-footer-link:hover,
    #luxo-landing-{{ section.id }} .lb-see-all:hover {
      color: var(--lb-text);
    }

    #luxo-landing-{{ section.id }} .lb-menu-link {
      font-size: 10px;
      line-height: 1;
      letter-spacing: .18em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    #luxo-landing-{{ section.id }} .lb-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 48px;
      padding: 13px 22px;
      border: 1px solid transparent;
      border-radius: calc(var(--lb-radius) + 2px);
      text-decoration: none;
      cursor: pointer;
      transition: .25s ease;
      font-size: 11px;
      line-height: 1;
      letter-spacing: .16em;
      text-transform: uppercase;
      font-weight: 700;
      text-align: center;
    }

    #luxo-landing-{{ section.id }} .lb-btn:hover {
      transform: translateY(-1px);
    }

    #luxo-landing-{{ section.id }} .lb-btn-primary {
      background: var(--lb-dark);
      color: #fff;
      border-color: var(--lb-dark);
      box-shadow: 0 10px 24px rgba(0,0,0,.08);
    }

    #luxo-landing-{{ section.id }} .lb-btn-primary:hover {
      opacity: .94;
    }

    #luxo-landing-{{ section.id }} .lb-btn-secondary {
      background: transparent;
      color: var(--lb-text);
      border-color: var(--lb-border);
    }

    #luxo-landing-{{ section.id }} .lb-btn-secondary:hover {
      background: rgba(0,0,0,.035);
    }

    #luxo-landing-{{ section.id }} .lb-btn-light {
      background: #fff;
      color: var(--lb-dark);
      border-color: #fff;
      box-shadow: 0 10px 24px rgba(0,0,0,.12);
    }

    #luxo-landing-{{ section.id }} .lb-btn-outline-light {
      background: transparent;
      color: #fff;
      border-color: rgba(255,255,255,.24);
    }

    #luxo-landing-{{ section.id }} .lb-btn-outline-light:hover {
      background: rgba(255,255,255,.08);
    }

    #luxo-landing-{{ section.id }} .lb-hero {
      padding-top: 52px;
      padding-bottom: 64px;
    }

    #luxo-landing-{{ section.id }} .lb-hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.02fr) minmax(0, .98fr);
      gap: 54px;
      align-items: center;
    }

    #luxo-landing-{{ section.id }} .lb-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 18px;
      font-size: 10px;
      line-height: 1;
      letter-spacing: .24em;
      text-transform: uppercase;
      color: var(--lb-accent);
    }

    #luxo-landing-{{ section.id }} .lb-eyebrow::before {
      content: "";
      width: 28px;
      height: 1px;
      background: currentColor;
      opacity: .7;
    }

    #luxo-landing-{{ section.id }} .lb-hero-title {
      margin: 0 0 18px;
      font-size: clamp(40px, 6vw, 74px);
      line-height: .95;
      letter-spacing: -.035em;
      color: var(--lb-text);
      max-width: 720px;
    }

    #luxo-landing-{{ section.id }} .lb-hero-title .lb-accent {
      color: var(--lb-accent);
      font-style: italic;
    }

    #luxo-landing-{{ section.id }} .lb-copy {
      max-width: 620px;
      color: var(--lb-muted);
      font-size: 15px;
      line-height: 1.82;
    }

    #luxo-landing-{{ section.id }} .lb-copy strong {
      color: var(--lb-text);
    }

    #luxo-landing-{{ section.id }} .lb-hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 28px;
      margin-bottom: 18px;
    }

    #luxo-landing-{{ section.id }} .lb-hero-support {
      font-size: 12px;
      line-height: 1.65;
      color: var(--lb-muted);
      margin-top: 2px;
    }

    #luxo-landing-{{ section.id }} .lb-micro-list {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 18px;
    }

    #luxo-landing-{{ section.id }} .lb-micro-item {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 34px;
      padding: 8px 12px;
      background: rgba(255,255,255,.72);
      border: 1px solid var(--lb-border);
      border-radius: 999px;
      color: var(--lb-text);
      font-size: 10px;
      line-height: 1;
      letter-spacing: .16em;
      text-transform: uppercase;
    }

    #luxo-landing-{{ section.id }} .lb-micro-item::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--lb-accent);
      display: inline-block;
    }

    #luxo-landing-{{ section.id }} .lb-hero-media {
      position: relative;
      min-width: 0;
    }

    #luxo-landing-{{ section.id }} .lb-hero-image-shell {
      position: relative;
      overflow: hidden;
      aspect-ratio: 4 / 5;
      border-radius: calc(var(--lb-radius) + 8px);
      background: #efe9e1;
      box-shadow: 0 24px 50px rgba(0,0,0,.08);
    }

    #luxo-landing-{{ section.id }} .lb-hero-image-shell img,
    #luxo-landing-{{ section.id }} .lb-card-image img,
    #luxo-landing-{{ section.id }} .lb-brand-image img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    #luxo-landing-{{ section.id }} .lb-float-card {
      position: absolute;
      left: -18px;
      bottom: 22px;
      width: 190px;
      background: rgba(255,255,255,.92);
      border: 1px solid rgba(0,0,0,.06);
      box-shadow: 0 18px 40px rgba(0,0,0,.12);
      border-radius: calc(var(--lb-radius) + 4px);
      padding: 16px;
    }

    #luxo-landing-{{ section.id }} .lb-float-card-title {
      margin: 0;
      font-size: 26px;
      line-height: 1;
      color: var(--lb-text);
    }

    #luxo-landing-{{ section.id }} .lb-float-card-copy {
      margin-top: 8px;
      font-size: 10px;
      line-height: 1.5;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--lb-muted);
    }

    #luxo-landing-{{ section.id }} .lb-trust-bar {
      border-top: 1px solid var(--lb-border);
      border-bottom: 1px solid var(--lb-border);
      background: rgba(0,0,0,.02);
    }

    #luxo-landing-{{ section.id }} .lb-trust-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
      padding-top: 18px;
      padding-bottom: 18px;
    }

    #luxo-landing-{{ section.id }} .lb-trust-item {
      text-align: center;
      padding: 10px 12px;
    }

    #luxo-landing-{{ section.id }} .lb-trust-icon {
      width: 18px;
      height: 18px;
      border: 1px solid var(--lb-text);
      margin: 0 auto 10px;
      transform: rotate(45deg);
      opacity: .85;
    }

    #luxo-landing-{{ section.id }} .lb-trust-title {
      font-size: 10px;
      line-height: 1.4;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: var(--lb-text);
    }

    #luxo-landing-{{ section.id }} .lb-center {
      text-align: center;
    }

    #luxo-landing-{{ section.id }} .lb-title {
      margin: 0;
      color: var(--lb-text);
      font-size: clamp(30px, 4vw, 48px);
      line-height: 1.06;
      letter-spacing: -.025em;
    }

    #luxo-landing-{{ section.id }} .lb-subtitle {
      max-width: 760px;
      margin: 16px auto 0;
      color: var(--lb-muted);
      font-size: 14px;
      line-height: 1.85;
    }

    #luxo-landing-{{ section.id }} .lb-benefit-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
      margin-top: 34px;
    }

    #luxo-landing-{{ section.id }} .lb-benefit {
      background: var(--lb-surface);
      border: 1px solid var(--lb-border);
      padding: 26px 22px;
      min-height: 210px;
      border-radius: calc(var(--lb-radius) + 4px);
      transition: .25s ease;
    }

    #luxo-landing-{{ section.id }} .lb-benefit:hover {
      transform: translateY(-4px);
      box-shadow: 0 14px 28px rgba(0,0,0,.05);
    }

    #luxo-landing-{{ section.id }} .lb-benefit-mark {
      width: 18px;
      height: 18px;
      color: var(--lb-accent);
      font-size: 18px;
      line-height: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
    }

    #luxo-landing-{{ section.id }} .lb-card-title {
      margin: 0 0 10px;
      font-size: 22px;
      line-height: 1.12;
      color: var(--lb-text);
    }

    #luxo-landing-{{ section.id }} .lb-muted {
      color: var(--lb-muted);
    }

    #luxo-landing-{{ section.id }} .lb-small {
      font-size: 13px;
      line-height: 1.75;
    }

    #luxo-landing-{{ section.id }} .lb-row-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 20px;
      margin-bottom: 18px;
    }

    #luxo-landing-{{ section.id }} .lb-see-all {
      font-size: 10px;
      line-height: 1;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: var(--lb-text);
      border-bottom: 1px solid var(--lb-text);
      padding-bottom: 4px;
      white-space: nowrap;
    }

    #luxo-landing-{{ section.id }} .lb-collection-description {
      max-width: 760px;
      color: var(--lb-muted);
      font-size: 14px;
      line-height: 1.82;
      margin-bottom: 28px;
    }

    #luxo-landing-{{ section.id }} .lb-products-wrap {
      position: relative;
      min-width: 0;
    }

    #luxo-landing-{{ section.id }} .lb-products {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
    }

    #luxo-landing-{{ section.id }} .lb-product {
      display: flex;
      flex-direction: column;
      gap: 14px;
      min-width: 0;
      background: var(--lb-surface);
      border: 1px solid var(--lb-border);
      border-radius: calc(var(--lb-radius) + 4px);
      padding: 14px;
      box-shadow: 0 8px 18px rgba(0,0,0,.03);
    }

    #luxo-landing-{{ section.id }} .lb-card-image {
      position: relative;
      overflow: hidden;
      aspect-ratio: 4 / 5;
      border-radius: calc(var(--lb-radius) + 2px);
      background: #efebe6;
    }

    #luxo-landing-{{ section.id }} .lb-card-image img {
      transition: transform .45s ease;
    }

    #luxo-landing-{{ section.id }} .lb-product:hover .lb-card-image img {
      transform: scale(1.03);
    }

    #luxo-landing-{{ section.id }} .lb-badge {
      position: absolute;
      left: 10px;
      top: 10px;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      min-height: 24px;
      padding: 0 10px;
      background: var(--lb-dark);
      color: #fff;
      font-size: 9px;
      line-height: 1;
      letter-spacing: .14em;
      text-transform: uppercase;
      border-radius: 999px;
    }

    #luxo-landing-{{ section.id }} .lb-badge-sale {
      background: #1c1c1c;
      color: #fff;
    }

    #luxo-landing-{{ section.id }} .lb-product-meta {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 12px;
      align-items: start;
    }

    #luxo-landing-{{ section.id }} .lb-product-info {
      min-width: 0;
    }

    #luxo-landing-{{ section.id }} .lb-product-title {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      color: var(--lb-text);
      font-size: 24px;
      line-height: 1.08;
      letter-spacing: -.02em;
    }

    #luxo-landing-{{ section.id }} .lb-price-wrap {
      text-align: right;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 4px;
      white-space: nowrap;
    }

    #luxo-landing-{{ section.id }} .lb-price {
      font-size: 15px;
      line-height: 1.3;
      color: var(--lb-text);
      font-weight: 700;
    }

    #luxo-landing-{{ section.id }} .lb-compare-price {
      font-size: 12px;
      line-height: 1.2;
      color: var(--lb-muted);
      text-decoration: line-through;
    }

    #luxo-landing-{{ section.id }} .lb-caption {
      font-size: 10px;
      line-height: 1.5;
      letter-spacing: .15em;
      text-transform: uppercase;
      color: var(--lb-muted);
      margin-top: 8px;
    }

    #luxo-landing-{{ section.id }} .lb-product-footer {
      margin-top: auto;
    }

    #luxo-landing-{{ section.id }} .lb-product-footer .lb-btn {
      width: 100%;
    }

    #luxo-landing-{{ section.id }} .lb-empty-products {
      border: 1px dashed var(--lb-border);
      color: var(--lb-muted);
      padding: 28px;
      text-align: center;
      font-size: 14px;
      line-height: 1.8;
      background: rgba(255,255,255,.35);
      border-radius: calc(var(--lb-radius) + 4px);
    }

    #luxo-landing-{{ section.id }} .lb-collection-cta {
      margin-top: 32px;
      background: linear-gradient(135deg, rgba(255,255,255,.55), rgba(0,0,0,.02));
      border: 1px solid var(--lb-border);
      border-radius: calc(var(--lb-radius) + 8px);
      padding: 28px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 24px;
      align-items: center;
    }

    #luxo-landing-{{ section.id }} .lb-collection-cta-title {
      margin: 0 0 10px;
      font-size: clamp(28px, 3vw, 38px);
      line-height: 1.04;
      letter-spacing: -.02em;
      color: var(--lb-text);
    }

    #luxo-landing-{{ section.id }} .lb-collection-cta-text {
      max-width: 720px;
      color: var(--lb-muted);
      font-size: 14px;
      line-height: 1.82;
      margin: 0;
    }

    #luxo-landing-{{ section.id }} .lb-collection-cta-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: flex-end;
    }

    #luxo-landing-{{ section.id }} .lb-brand-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 56px;
      align-items: center;
    }

    #luxo-landing-{{ section.id }} .lb-brand-image {
      aspect-ratio: 1 / 1;
      background: #ddd7cf;
      overflow: hidden;
      border-radius: calc(var(--lb-radius) + 8px);
      box-shadow: 0 20px 40px rgba(0,0,0,.06);
    }

    #luxo-landing-{{ section.id }} .lb-testimonials {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      margin-top: 34px;
    }

    #luxo-landing-{{ section.id }} .lb-testimonial {
      background: var(--lb-surface);
      padding: 28px 24px;
      min-height: 220px;
      border: 1px solid var(--lb-border);
      border-radius: calc(var(--lb-radius) + 4px);
      box-shadow: 0 8px 18px rgba(0,0,0,.03);
    }

    #luxo-landing-{{ section.id }} .lb-stars {
      color: var(--lb-accent);
      letter-spacing: 4px;
      font-size: 14px;
      line-height: 1;
      margin-bottom: 16px;
    }

    #luxo-landing-{{ section.id }} .lb-quote {
      margin: 0 0 18px;
      font-style: italic;
      font-size: 18px;
      line-height: 1.7;
      color: var(--lb-text);
    }

    #luxo-landing-{{ section.id }} .lb-author {
      font-size: 10px;
      line-height: 1.5;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: var(--lb-muted);
    }

    #luxo-landing-{{ section.id }} .lb-guarantee {
      background: var(--lb-surface);
      border: 2px dashed var(--lb-accent);
      border-radius: calc(var(--lb-radius) + 8px);
      padding: 36px 24px;
      text-align: center;
      max-width: 800px;
      margin: 0 auto;
      box-shadow: 0 10px 30px rgba(0,0,0,.04);
    }

    #luxo-landing-{{ section.id }} .lb-guarantee-title {
      font-size: 28px;
      margin: 0 0 12px;
      color: var(--lb-text);
      font-family: Georgia, "Times New Roman", serif;
    }

    #luxo-landing-{{ section.id }} .lb-guarantee-text {
      font-size: 16px;
      color: var(--lb-muted);
      margin: 0;
      line-height: 1.6;
    }

    #luxo-landing-{{ section.id }} .lb-dark-cta {
      background: var(--lb-dark);
      color: #fff;
      position: relative;
      overflow: hidden;
    }

    #luxo-landing-{{ section.id }} .lb-dark-cta::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,0));
      pointer-events: none;
    }

    #luxo-landing-{{ section.id }} .lb-dark-inner {
      position: relative;
      z-index: 1;
      max-width: 800px;
      margin: 0 auto;
      text-align: center;
      padding-top: 86px;
      padding-bottom: 86px;
    }

    #luxo-landing-{{ section.id }} .lb-dark-title {
      margin: 0 0 16px;
      color: #fff;
      font-size: clamp(34px, 5vw, 64px);
      line-height: .98;
      letter-spacing: -.03em;
    }

    #luxo-landing-{{ section.id }} .lb-dark-copy {
      max-width: 620px;
      margin: 0 auto;
      color: rgba(255,255,255,.76);
      font-size: 15px;
      line-height: 1.8;
    }

    #luxo-landing-{{ section.id }} .lb-dark-actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 26px;
    }

    #luxo-landing-{{ section.id }} .lb-inner-footer {
      border-top: 1px solid var(--lb-border);
      background: rgba(255,255,255,.42);
    }

    #luxo-landing-{{ section.id }} .lb-footer-row {
      min-height: 84px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
      padding-top: 18px;
      padding-bottom: 18px;
    }

    #luxo-landing-{{ section.id }} .lb-footer-copy {
      font-size: 10px;
      line-height: 1.5;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--lb-muted);
      margin-top: 6px;
    }

    #luxo-landing-{{ section.id }} .lb-footer-links {
      display: flex;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
    }

    #luxo-landing-{{ section.id }} .lb-footer-link {
      font-size: 10px;
      line-height: 1;
      letter-spacing: .18em;
      text-transform: uppercase;
    }

    #luxo-landing-{{ section.id }} .lb-empty-image {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--lb-muted);
      background: linear-gradient(180deg, rgba(0,0,0,.02), rgba(0,0,0,.04));
      font-size: 12px;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    #luxo-landing-{{ section.id }} .lb-mobile-sticky {
      display: none;
    }

    @media (max-width: 1200px) {
      #luxo-landing-{{ section.id }} .lb-products {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 989px) {
      #luxo-landing-{{ section.id }} .lb-wrap {
        padding-left: 20px;
        padding-right: 20px;
      }

      #luxo-landing-{{ section.id }} .lb-header-row {
        grid-template-columns: 1fr auto;
      }

      #luxo-landing-{{ section.id }} .lb-header-center {
        display: none;
      }

      #luxo-landing-{{ section.id }} .lb-hero-grid,
      #luxo-landing-{{ section.id }} .lb-brand-grid,
      #luxo-landing-{{ section.id }} .lb-collection-cta {
        grid-template-columns: 1fr;
      }

      #luxo-landing-{{ section.id }} .lb-benefit-grid,
      #luxo-landing-{{ section.id }} .lb-testimonials,
      #luxo-landing-{{ section.id }} .lb-trust-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #luxo-landing-{{ section.id }} .lb-products {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #luxo-landing-{{ section.id }} .lb-collection-cta-actions {
        justify-content: flex-start;
      }

      #luxo-landing-{{ section.id }} .lb-float-card {
        left: 14px;
        bottom: 14px;
        width: 170px;
      }
    }

    @media (max-width: 749px) {
      #luxo-landing-{{ section.id }} {
        {% if section.settings.show_sticky_mobile_cta %}
          padding-bottom: calc(var(--lb-outer-bottom) + 92px);
        {% endif %}
      }

      #luxo-landing-{{ section.id }} .lb-wrap {
        padding-left: 16px;
        padding-right: 16px;
      }

      #luxo-landing-{{ section.id }} .lb-hero {
        padding-top: 28px;
        padding-bottom: 36px;
      }

      #luxo-landing-{{ section.id }} .lb-hero-title {
        font-size: 46px;
      }

      #luxo-landing-{{ section.id }} .lb-copy,
      #luxo-landing-{{ section.id }} .lb-dark-copy,
      #luxo-landing-{{ section.id }} .lb-collection-cta-text,
      #luxo-landing-{{ section.id }} .lb-collection-description {
        font-size: 14px;
      }

      #luxo-landing-{{ section.id }} .lb-hero-actions,
      #luxo-landing-{{ section.id }} .lb-dark-actions,
      #luxo-landing-{{ section.id }} .lb-collection-cta-actions {
        flex-direction: column;
      }

      #luxo-landing-{{ section.id }} .lb-btn,
      #luxo-landing-{{ section.id }} .lb-collection-cta-actions .lb-btn,
      #luxo-landing-{{ section.id }} .lb-dark-actions .lb-btn {
        width: 100%;
      }

      #luxo-landing-{{ section.id }} .lb-trust-grid,
      #luxo-landing-{{ section.id }} .lb-benefit-grid,
      #luxo-landing-{{ section.id }} .lb-testimonials {
        grid-template-columns: 1fr;
      }

      #luxo-landing-{{ section.id }} .lb-row-head {
        flex-direction: column;
        align-items: flex-start;
      }

      #luxo-landing-{{ section.id }} .lb-products {
        display: flex;
        gap: 16px;
        overflow-x: auto;
        padding-bottom: 8px;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
      }

      #luxo-landing-{{ section.id }} .lb-products::-webkit-scrollbar {
        height: 6px;
      }

      #luxo-landing-{{ section.id }} .lb-products::-webkit-scrollbar-thumb {
        background: rgba(0,0,0,.15);
        border-radius: 999px;
      }

      #luxo-landing-{{ section.id }} .lb-product {
        flex: 0 0 84%;
        scroll-snap-align: start;
      }

      #luxo-landing-{{ section.id }} .lb-product-meta {
        grid-template-columns: 1fr;
      }

      #luxo-landing-{{ section.id }} .lb-price-wrap {
        align-items: flex-start;
        text-align: left;
      }

      #luxo-landing-{{ section.id }} .lb-collection-cta {
        padding: 22px 18px;
      }

      #luxo-landing-{{ section.id }} .lb-dark-inner {
        padding-top: 62px;
        padding-bottom: 62px;
      }

      #luxo-landing-{{ section.id }} .lb-float-card {
        display: none;
      }

      #luxo-landing-{{ section.id }} .lb-footer-row {
        align-items: flex-start;
      }

      #luxo-landing-{{ section.id }} .lb-mobile-sticky {
        display: block;
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 35;
        padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
        background: rgba(247,244,239,.96);
        backdrop-filter: blur(10px);
        border-top: 1px solid var(--lb-border);
      }

      #luxo-landing-{{ section.id }} .lb-mobile-sticky-inner {
        display: grid;
        grid-template-columns: 1fr;
        gap: 8px;
      }

      #luxo-landing-{{ section.id }} .lb-mobile-sticky-note {
        text-align: center;
        font-size: 10px;
        line-height: 1.4;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: var(--lb-muted);
      }
    }
  </style>

  {% if section.settings.show_campaign_notice and section.settings.campaign_notice_text != blank %}
    <div class="lb-notice">
      <div class="lb-wrap">
        <div class="lb-notice-inner">{{ section.settings.campaign_notice_text }}</div>
      </div>
    </div>
  {% endif %}

  {% if section.settings.show_inner_header %}
    <div class="lb-inner-header">
      <div class="lb-wrap">
        <div class="lb-header-row">
          <div class="lb-header-left">
            {% if section.settings.brand_name != blank %}
              <div class="lb-brand">{{ section.settings.brand_name }}</div>
            {% endif %}
          </div>

          <div class="lb-header-center">
            {% if section.settings.header_micro_text != blank %}
              <div class="lb-header-micro">{{ section.settings.header_micro_text }}</div>
            {% endif %}
          </div>

          <div class="lb-header-right">
            {% if section.settings.size_guide_label != blank and section.settings.size_guide_url != blank %}
              <a class="lb-menu-link" href="{{ section.settings.size_guide_url }}">{{ section.settings.size_guide_label }}</a>
            {% endif %}

            {% if section.settings.header_cta_label != blank and section.settings.header_cta_url != blank %}
              <a class="lb-btn lb-btn-primary" href="{{ section.settings.header_cta_url }}">{{ section.settings.header_cta_label }}</a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  <div class="lb-wrap">
    <div class="lb-hero">
      <div class="lb-hero-grid">
        <div class="lb-hero-content">
          {% if section.settings.hero_badge_text != blank %}
            <span class="lb-eyebrow">{{ section.settings.hero_badge_text }}</span>
          {% endif %}

          <h1 class="lb-hero-title">
            {% if section.settings.hero_heading_top != blank %}{{ section.settings.hero_heading_top }}<br>{% endif %}
            {% if section.settings.hero_heading_accent != blank %}<span class="lb-accent">{{ section.settings.hero_heading_accent }}</span>{% endif %}
            {% if section.settings.hero_heading_after_accent != blank %} {{ section.settings.hero_heading_after_accent }}{% endif %}
            {% if section.settings.hero_heading_bottom != blank %}<br>{{ section.settings.hero_heading_bottom }}{% endif %}
          </h1>

          {% if section.settings.hero_text != blank %}
            <div class="lb-copy lb-rte">{{ section.settings.hero_text }}</div>
          {% endif %}

          <div class="lb-hero-actions">
            {% if section.settings.hero_primary_label != blank and hero_primary_href != blank %}
              <a class="lb-btn lb-btn-primary" href="{{ hero_primary_href }}">{{ section.settings.hero_primary_label }}</a>
            {% endif %}

            {% if section.settings.hero_secondary_label != blank and hero_secondary_href != blank %}
              <a class="lb-btn lb-btn-secondary" href="{{ hero_secondary_href }}">{{ section.settings.hero_secondary_label }}</a>
            {% endif %}
          </div>

          {% if section.settings.hero_support_text != blank %}
            <div class="lb-hero-support">{{ section.settings.hero_support_text }}</div>
          {% endif %}

          {% if section.settings.hero_micro_1 != blank or section.settings.hero_micro_2 != blank or section.settings.hero_micro_3 != blank %}
            <div class="lb-micro-list">
              {% if section.settings.hero_micro_1 != blank %}
                <div class="lb-micro-item">{{ section.settings.hero_micro_1 }}</div>
              {% endif %}
              {% if section.settings.hero_micro_2 != blank %}
                <div class="lb-micro-item">{{ section.settings.hero_micro_2 }}</div>
              {% endif %}
              {% if section.settings.hero_micro_3 != blank %}
                <div class="lb-micro-item">{{ section.settings.hero_micro_3 }}</div>
              {% endif %}
            </div>
          {% endif %}
        </div>

        <div class="lb-hero-media">
          <div class="lb-hero-image-shell">
            {% if section.settings.hero_image != blank %}
              {{
                section.settings.hero_image
                | image_url: width: 1600
                | image_tag:
                  loading: 'eager',
                  widths: '375, 550, 750, 1100, 1400, 1600',
                  sizes: '(max-width: 749px) 100vw, (max-width: 989px) 100vw, 50vw',
                  alt: section.settings.hero_image_alt | escape
              }}
            {% else %}
              <div class="lb-empty-image">Imagen principal</div>
            {% endif %}
          </div>

          {% if section.settings.show_hero_float_card %}
            <div class="lb-float-card">
              {% if section.settings.hero_float_title != blank %}
                <p class="lb-float-card-title">{{ section.settings.hero_float_title }}</p>
              {% endif %}
              {% if section.settings.hero_float_text != blank %}
                <div class="lb-float-card-copy">{{ section.settings.hero_float_text }}</div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  {% if trust_blocks.size > 0 %}
    <div class="lb-trust-bar">
      <div class="lb-wrap">
        <div class="lb-trust-grid">
          {% for block in trust_blocks %}
            <div class="lb-trust-item" {{ block.shopify_attributes }}>
              <div class="lb-trust-icon"></div>
              <div class="lb-trust-title">{{ block.settings.title }}</div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  <div class="lb-section">
    <div class="lb-wrap">
      <div class="lb-center">
        {% if section.settings.benefits_eyebrow != blank %}
          <span class="lb-eyebrow">{{ section.settings.benefits_eyebrow }}</span>
        {% endif %}
        {% if section.settings.benefits_title != blank %}
          <h2 class="lb-title">{{ section.settings.benefits_title }}</h2>
        {% endif %}
      </div>

      {% if benefit_blocks.size > 0 %}
        <div class="lb-benefit-grid">
          {% for block in benefit_blocks %}
            <div class="lb-benefit" {{ block.shopify_attributes }}>
              <div class="lb-benefit-mark">✦</div>
              {% if block.settings.title != blank %}
                <h3 class="lb-card-title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="lb-muted lb-small">{{ block.settings.text }}</div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>

  <div id="lb-products-{{ section.id }}" class="lb-section lb-alt">
    <div class="lb-wrap">
      <div class="lb-row-head">
        <div>
          {% if section.settings.products_eyebrow != blank %}
            <span class="lb-eyebrow">{{ section.settings.products_eyebrow }}</span>
          {% endif %}
          {% if resolved_products_title != blank %}
            <h2 class="lb-title">{{ resolved_products_title }}</h2>
          {% endif %}
        </div>

        {% if section.settings.products_link_label != blank and resolved_products_link != blank %}
          <a class="lb-see-all" href="{{ resolved_products_link }}">{{ section.settings.products_link_label }}</a>
        {% endif %}
      </div>

      {% if section.settings.show_collection_description and collection_description != blank %}
        <div class="lb-collection-description">{{ collection_description }}</div>
      {% endif %}

      {% if use_collection_products %}
        <div class="lb-products-wrap">
          <div class="lb-products">
            {% if section.settings.show_all_collection_products %}
              {% for product in promo_collection.products %}
                {% liquid
                  assign badge_text = blank
                  assign caption_text = product.type
                  if caption_text == blank
                    assign caption_text = section.settings.default_product_caption
                  endif

                  if product.available == false
                    assign badge_text = 'Agotado'
                  elsif product.compare_at_price > product.price and section.settings.show_sale_badge
                    assign badge_text = 'Oferta'
                  endif
                %}

                <div class="lb-product">
                  <div class="lb-card-image">
                    {% if badge_text != blank %}
                      <div class="lb-badge {% if badge_text == 'Oferta' %}lb-badge-sale{% endif %}">{{ badge_text }}</div>
                    {% endif %}

                    {% if product.featured_image != blank %}
                      {{
                        product.featured_image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          widths: '375, 550, 750, 900',
                          sizes: '(max-width: 749px) 84vw, (max-width: 989px) 50vw, 25vw',
                          alt: product.title | escape
                      }}
                    {% else %}
                      <div class="lb-empty-image">Imagen de producto</div>
                    {% endif %}
                  </div>

                  <div class="lb-product-meta">
                    <div class="lb-product-info">
                      <h3 class="lb-product-title">{{ product.title }}</h3>
                      {% if caption_text != blank %}
                        <div class="lb-caption">{{ caption_text }}</div>
                      {% endif %}
                    </div>

                    <div class="lb-price-wrap">
                      {% if product.compare_at_price > product.price and section.settings.show_compare_price %}
                        <div class="lb-compare-price">{{ product.compare_at_price | money }}</div>
                      {% endif %}
                      <div class="lb-price">{{ product.price | money }}</div>
                    </div>
                  </div>

                  <div class="lb-product-footer">
                    {% if section.settings.product_button_label != blank %}
                      <a class="lb-btn lb-btn-primary" href="{{ product.url }}">{{ section.settings.product_button_label }}</a>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            {% else %}
              {% for product in promo_collection.products limit: section.settings.collection_products_limit %}
                {% liquid
                  assign badge_text = blank
                  assign caption_text = product.type
                  if caption_text == blank
                    assign caption_text = section.settings.default_product_caption
                  endif

                  if product.available == false
                    assign badge_text = 'Agotado'
                  elsif product.compare_at_price > product.price and section.settings.show_sale_badge
                    assign badge_text = 'Oferta'
                  endif
                %}

                <div class="lb-product">
                  <div class="lb-card-image">
                    {% if badge_text != blank %}
                      <div class="lb-badge {% if badge_text == 'Oferta' %}lb-badge-sale{% endif %}">{{ badge_text }}</div>
                    {% endif %}

                    {% if product.featured_image != blank %}
                      {{
                        product.featured_image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          widths: '375, 550, 750, 900',
                          sizes: '(max-width: 749px) 84vw, (max-width: 989px) 50vw, 25vw',
                          alt: product.title | escape
                      }}
                    {% else %}
                      <div class="lb-empty-image">Imagen de producto</div>
                    {% endif %}
                  </div>

                  <div class="lb-product-meta">
                    <div class="lb-product-info">
                      <h3 class="lb-product-title">{{ product.title }}</h3>
                      {% if caption_text != blank %}
                        <div class="lb-caption">{{ caption_text }}</div>
                      {% endif %}
                    </div>

                    <div class="lb-price-wrap">
                      {% if product.compare_at_price > product.price and section.settings.show_compare_price %}
                        <div class="lb-compare-price">{{ product.compare_at_price | money }}</div>
                      {% endif %}
                      <div class="lb-price">{{ product.price | money }}</div>
                    </div>
                  </div>

                  <div class="lb-product-footer">
                    {% if section.settings.product_button_label != blank %}
                      <a class="lb-btn lb-btn-primary" href="{{ product.url }}">{{ section.settings.product_button_label }}</a>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            {% endif %}
          </div>
        </div>
      {% elsif product_blocks.size > 0 %}
        <div class="lb-products-wrap">
          <div class="lb-products">
            {% for block in product_blocks %}
              {% liquid
                assign chosen_product = block.settings.product
                assign card_title = block.settings.title
                assign card_desc = block.settings.caption
                assign card_url = block.settings.url
                assign card_price = block.settings.price_text
                assign card_image = block.settings.image
                assign badge_text = block.settings.badge
                assign compare_price = blank

                if chosen_product != blank
                  if card_title == blank
                    assign card_title = chosen_product.title
                  endif

                  if card_url == blank
                    assign card_url = chosen_product.url
                  endif

                  if card_price == blank
                    assign card_price = chosen_product.price | money
                  endif

                  if chosen_product.compare_at_price > chosen_product.price
                    assign compare_price = chosen_product.compare_at_price | money
                  endif

                  if card_desc == blank
                    assign card_desc = chosen_product.type
                  endif

                  if card_desc == blank
                    assign card_desc = section.settings.default_product_caption
                  endif

                  if card_image == blank and chosen_product.featured_image != blank
                    assign card_image = chosen_product.featured_image
                  endif

                  if badge_text == blank
                    if chosen_product.available == false
                      assign badge_text = 'Agotado'
                    elsif chosen_product.compare_at_price > chosen_product.price and section.settings.show_sale_badge
                      assign badge_text = 'Oferta'
                    endif
                  endif
                endif
              %}

              <div class="lb-product" {{ block.shopify_attributes }}>
                <div class="lb-card-image">
                  {% if badge_text != blank %}
                    <div class="lb-badge {% if badge_text == 'Oferta' %}lb-badge-sale{% endif %}">{{ badge_text }}</div>
                  {% endif %}

                  {% if card_image != blank %}
                    {{
                      card_image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '375, 550, 750, 900',
                        sizes: '(max-width: 749px) 84vw, (max-width: 989px) 50vw, 25vw',
                        alt: card_title | escape
                    }}
                  {% else %}
                    <div class="lb-empty-image">Imagen de producto</div>
                  {% endif %}
                </div>

                <div class="lb-product-meta">
                  <div class="lb-product-info">
                    {% if card_title != blank %}
                      <h3 class="lb-product-title">{{ card_title }}</h3>
                    {% endif %}
                    {% if card_desc != blank %}
                      <div class="lb-caption">{{ card_desc }}</div>
                    {% endif %}
                  </div>

                  <div class="lb-price-wrap">
                    {% if compare_price != blank and section.settings.show_compare_price %}
                      <div class="lb-compare-price">{{ compare_price }}</div>
                    {% endif %}
                    {% if card_price != blank %}
                      <div class="lb-price">{{ card_price }}</div>
                    {% endif %}
                  </div>
                </div>

                <div class="lb-product-footer">
                  {% if block.settings.show_button and block.settings.button_label != blank and card_url != blank %}
                    <a class="lb-btn lb-btn-primary" href="{{ card_url }}">{{ block.settings.button_label }}</a>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% else %}
        <div class="lb-empty-products">
          {{ section.settings.empty_products_text }}
        </div>
      {% endif %}

      {% if section.settings.show_collection_cta %}
        <div class="lb-collection-cta">
          <div>
            {% if section.settings.collection_cta_title != blank %}
              <h3 class="lb-collection-cta-title">{{ section.settings.collection_cta_title }}</h3>
            {% endif %}
            {% if section.settings.collection_cta_text != blank %}
              <div class="lb-collection-cta-text lb-rte">{{ section.settings.collection_cta_text }}</div>
            {% endif %}
          </div>

          <div class="lb-collection-cta-actions">
            {% if section.settings.collection_cta_primary_label != blank and collection_cta_primary_href != blank %}
              <a class="lb-btn lb-btn-primary" href="{{ collection_cta_primary_href }}">{{ section.settings.collection_cta_primary_label }}</a>
            {% endif %}

            {% if section.settings.collection_cta_secondary_label != blank and collection_cta_secondary_href != blank %}
              <a class="lb-btn lb-btn-secondary" href="{{ collection_cta_secondary_href }}">{{ section.settings.collection_cta_secondary_label }}</a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  <div class="lb-section">
    <div class="lb-wrap">
      <div class="lb-brand-grid">
        <div class="lb-brand-image">
          {% if section.settings.brand_image != blank %}
            {{
              section.settings.brand_image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '375, 550, 750, 1100, 1200',
                sizes: '(max-width: 989px) 100vw, 50vw',
                alt: section.settings.brand_title | escape
            }}
          {% else %}
            <div class="lb-empty-image">Imagen de marca</div>
          {% endif %}
        </div>

        <div class="lb-brand-copy">
          {% if section.settings.brand_eyebrow != blank %}
            <span class="lb-eyebrow">{{ section.settings.brand_eyebrow }}</span>
          {% endif %}

          {% if section.settings.brand_title != blank %}
            <h2 class="lb-title">{{ section.settings.brand_title }}</h2>
          {% endif %}

          {% if section.settings.brand_text != blank %}
            <div class="lb-copy lb-rte" style="margin-top: 18px;">{{ section.settings.brand_text }}</div>
          {% endif %}

          {% if section.settings.brand_button_label != blank and section.settings.brand_button_url != blank %}
            <div style="margin-top: 24px;">
              <a class="lb-btn lb-btn-primary" href="{{ section.settings.brand_button_url }}">{{ section.settings.brand_button_label }}</a>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  {% if testimonial_blocks.size > 0 %}
    <div class="lb-section">
      <div class="lb-wrap">
        <div class="lb-center">
          {% if section.settings.testimonials_eyebrow != blank %}
            <span class="lb-eyebrow">{{ section.settings.testimonials_eyebrow }}</span>
          {% endif %}
          {% if section.settings.testimonials_title != blank %}
            <h2 class="lb-title">{{ section.settings.testimonials_title }}</h2>
          {% endif %}
          {% if section.settings.testimonials_text != blank %}
            <div class="lb-subtitle lb-rte">{{ section.settings.testimonials_text }}</div>
          {% endif %}
        </div>

        <div class="lb-testimonials">
          {% for block in testimonial_blocks %}
            <div class="lb-testimonial" {{ block.shopify_attributes }}>
              <div class="lb-stars">
                {% assign stars = block.settings.stars | default: 5 %}
                {% for i in (1..stars) %}★{% endfor %}
              </div>

              {% if block.settings.quote != blank %}
                <p class="lb-quote">“{{ block.settings.quote }}”</p>
              {% endif %}

              {% if block.settings.author != blank %}
                <div class="lb-author">— {{ block.settings.author }}</div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  {% if section.settings.show_guarantee %}
    <div class="lb-section">
      <div class="lb-wrap">
        <div class="lb-guarantee">
          {% if section.settings.guarantee_title != blank %}
            <h3 class="lb-guarantee-title">🛡️ {{ section.settings.guarantee_title }}</h3>
          {% endif %}
          {% if section.settings.guarantee_text != blank %}
            <p class="lb-guarantee-text">{{ section.settings.guarantee_text }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}

  <div class="lb-dark-cta">
    <div class="lb-wrap">
      <div class="lb-dark-inner">
        {% if section.settings.final_title != blank %}
          <h2 class="lb-dark-title">{{ section.settings.final_title | newline_to_br }}</h2>
        {% endif %}

        {% if section.settings.final_text != blank %}
          <div class="lb-dark-copy lb-rte">{{ section.settings.final_text }}</div>
        {% endif %}

        <div class="lb-dark-actions">
          {% if section.settings.final_primary_label != blank and final_primary_href != blank %}
            <a class="lb-btn lb-btn-light" href="{{ final_primary_href }}">{{ section.settings.final_primary_label }}</a>
          {% endif %}

          {% if section.settings.final_secondary_label != blank and final_secondary_href != blank %}
            <a class="lb-btn lb-btn-outline-light" href="{{ final_secondary_href }}">{{ section.settings.final_secondary_label }}</a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  {% if section.settings.show_inner_footer %}
    <div class="lb-inner-footer">
      <div class="lb-wrap">
        <div class="lb-footer-row">
          <div>
            {% if section.settings.footer_brand_name != blank %}
              <div class="lb-brand">{{ section.settings.footer_brand_name }}</div>
            {% endif %}
            {% if section.settings.footer_copy != blank %}
              <div class="lb-footer-copy">{{ section.settings.footer_copy }}</div>
            {% endif %}
          </div>

          {% if section.settings.footer_menu != blank %}
            <div class="lb-footer-links">
              {% for link in section.settings.footer_menu.links %}
                <a class="lb-footer-link" href="{{ link.url }}">{{ link.title }}</a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}

  {% if section.settings.show_sticky_mobile_cta and section.settings.sticky_mobile_label != blank and sticky_mobile_href != blank %}
    <div class="lb-mobile-sticky">
      <div class="lb-mobile-sticky-inner">
        <div class="lb-mobile-sticky-note">Oferta de tiempo limitado</div>
        <a class="lb-btn lb-btn-primary" href="{{ sticky_mobile_href }}">{{ section.settings.sticky_mobile_label }}</a>
      </div>
    </div>
  {% endif %}
</section>

