{%- liquid
  assign primary_menu = section.settings.menu
  assign announcement_link = section.settings.announcement_link
-%}

{%- style -%}
  .luxo-header__logo img { display: block; width: auto; height: 26px; }

  /* El anuncio se adapta: antes se cortaba por la izquierda al no caber en una línea */
  .luxo-announcement {
    flex-wrap: wrap;
    padding-inline: 12px;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  @media screen and (max-width: 899px) {
    .luxo-header__logo img { height: 21px; }

    /*
      backdrop-filter en el header creaba bloque contenedor: el panel fixed
      quedaba encerrado dentro de la barra en vez de cubrir la pantalla.
    */
    .luxo-header {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: var(--luxo-paper);
    }

    .luxo-header__inner {
      min-height: 58px;
      grid-template-columns: 44px minmax(0, 1fr) auto;
      gap: 10px;
      padding-inline: 14px;
    }

    .luxo-mobile-menu { position: static; display: block; width: 44px; }

    .luxo-mobile-menu > summary {
      position: relative;
      z-index: 10000;
      display: grid;
      width: 44px;
      height: 44px;
      place-items: center;
      color: var(--luxo-ink);
      cursor: pointer;
      list-style: none;
    }

    .luxo-mobile-menu > summary::-webkit-details-marker { display: none; }
    .luxo-mobile-menu > summary svg { width: 24px; height: 24px; }

    .luxo-mobile-menu__panel {
      position: fixed;
      z-index: 9990;
      inset: 0;
      overflow-y: auto;
      padding: max(18px, env(safe-area-inset-top)) 22px max(40px, env(safe-area-inset-bottom));
      color: var(--luxo-white);
      background: var(--luxo-ink);
      overscroll-behavior: contain;
    }

    .luxo-mobile-menu__top {
      display: flex;
      min-height: 44px;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 32px;
      padding-left: 46px;
      color: rgba(255, 255, 255, 0.72);
      font-size: 1.1rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .luxo-mobile-menu[open] > summary { color: var(--luxo-white); }

    .luxo-mobile-nav { display: grid; }

    .luxo-mobile-nav a {
      display: flex;
      min-height: 56px;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.22);
      color: var(--luxo-white);
      font-size: clamp(2.6rem, 8vw, 4rem);
      line-height: 1.05;
      letter-spacing: -0.03em;
      text-decoration: none;
      overflow-wrap: anywhere;
    }

    .luxo-mobile-nav a span:last-child { flex: none; font-size: 1.8rem; }

    .luxo-mobile-menu__secondary { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 34px; }

    .luxo-mobile-menu__secondary a {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      color: rgba(255, 255, 255, 0.72);
      font-size: 1.2rem;
      letter-spacing: 0.1em;
      text-decoration: none;
      text-transform: uppercase;
    }
  }

  @media screen and (min-width: 900px) {
    .luxo-mobile-menu { display: none; }
  }
{%- endstyle -%}

{%- if section.settings.show_announcement and section.settings.announcement_text != blank -%}
  {%- if announcement_link != blank -%}
    <a class="luxo-announcement" href="{{ announcement_link }}">{{ section.settings.announcement_text | escape }}</a>
  {%- else -%}
    <div class="luxo-announcement" role="status">{{ section.settings.announcement_text | escape }}</div>
  {%- endif -%}
{%- endif -%}

<header class="luxo-header" data-luxo-header>
  <div class="luxo-header__inner">
    <details class="luxo-mobile-menu">
      <summary
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="LuxoMobilePanel-{{ section.id }}"
      >
        <svg class="luxo-mobile-menu__open-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 7h18M3 17h18" stroke="currentColor" stroke-width="1.4"/></svg>
        <svg class="luxo-mobile-menu__close-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" stroke="currentColor" stroke-width="1.4"/></svg>
      </summary>
      <div class="luxo-mobile-menu__panel" id="LuxoMobilePanel-{{ section.id }}">
        <div class="luxo-mobile-menu__top">
          <span>{{ section.settings.wordmark | escape }}</span>
          <span>Menú</span>
        </div>
        <nav class="luxo-mobile-nav" aria-label="Navegación móvil">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
                <span>{{ block.settings.label | escape }}</span><span aria-hidden="true">↗</span>
              </a>
            {%- endfor -%}
          {%- else -%}
            {%- for link in primary_menu.links -%}
              <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}><span>{{ link.title | escape }}</span><span aria-hidden="true">↗</span></a>
            {%- endfor -%}
          {%- endif -%}
        </nav>
        <div class="luxo-mobile-menu__secondary">
          <a href="{{ routes.search_url }}">Buscar</a>
          {%- if shop.customer_accounts_enabled -%}<a href="{{ routes.account_url }}">Mi cuenta</a>{%- endif -%}
        </div>
      </div>
    </details>

    <nav class="luxo-header__nav luxo-header__nav--left" aria-label="Navegación principal">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks limit: 3 -%}
          <a class="luxo-header__link" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
        {%- endfor -%}
      {%- else -%}
        {%- for link in primary_menu.links limit: 3 -%}<a class="luxo-header__link{% if link.current %} is-active{% endif %}" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{%- endfor -%}
      {%- endif -%}
    </nav>

    <a class="luxo-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} — Inicio">
      <img
        src="{{ 'luxo-logo.png' | asset_url }}"
        alt="{{ section.settings.wordmark | default: shop.name | escape }}"
        width="300"
        height="58"
        loading="eager"
      >
    </a>

    <div class="luxo-header__right">
      <nav class="luxo-header__nav luxo-header__nav--right" aria-label="Colecciones destacadas">
        {%- if section.blocks.size > 3 -%}
          {%- for block in section.blocks offset: 3 limit: 2 -%}
            <a class="luxo-header__link" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
          {%- endfor -%}
        {%- else -%}
          {%- for link in primary_menu.links offset: 3 limit: 2 -%}<a class="luxo-header__link{% if link.current %} is-active{% endif %}" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{%- endfor -%}
        {%- endif -%}
      </nav>

      <div class="luxo-header__tools">
        <a class="luxo-header__tool" href="{{ routes.search_url }}" aria-label="Buscar">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
        </a>
        {%- if shop.customer_accounts_enabled -%}
          <a class="luxo-header__tool luxo-header__account" href="{{ routes.account_url }}" aria-label="Mi cuenta">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="7.5" r="3.5"/><path d="M5 21c.8-4.2 3.1-6.2 7-6.2s6.2 2 7 6.2"/></svg>
          </a>
        {%- endif -%}
        <a class="luxo-header__tool" href="{{ routes.cart_url }}" id="cart-icon-bubble" aria-label="Bolsa">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 8h12l-1 13H7L6 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>
          {%- if cart != empty -%}
            <span class="luxo-header__count" aria-hidden="true">{{ cart.item_count }}</span>
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          {%- endif -%}
        </a>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Luxo header",
  "class": "luxo-header-section",
  "settings": [
    { "type": "checkbox", "id": "show_announcement", "label": "Mostrar anuncio", "default": true },
    { "type": "text", "id": "announcement_text", "label": "Texto del anuncio", "default": "ENVÍOS A TODO EE. UU. · CAMBIOS FÁCILES" },
    { "type": "url", "id": "announcement_link", "label": "Enlace del anuncio" },
    { "type": "text", "id": "wordmark", "label": "Nombre de marca", "default": "LUXO" },
    { "type": "link_list", "id": "menu", "label": "Menú de respaldo", "default": "main-menu" }
  ],
  "blocks": [
    {
      "type": "nav_item",
      "name": "Enlace principal",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "NUEVO" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxo header",
      "blocks": [
        { "type": "nav_item", "settings": { "label": "NUEVO" } },
        { "type": "nav_item", "settings": { "label": "FAJAS" } },
        { "type": "nav_item", "settings": { "label": "ROPA" } },
        { "type": "nav_item", "settings": { "label": "BIENESTAR" } },
        { "type": "nav_item", "settings": { "label": "BESTSELLERS" } }
      ]
    }
  ]
}
{% endschema %}
