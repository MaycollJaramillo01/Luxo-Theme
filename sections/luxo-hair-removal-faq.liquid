{{ 'luxo-hair-removal-campaign.css' | asset_url | stylesheet_tag }}

<section
  class="lxhr"
  style="
    --lxhr-bg: {{ section.settings.bg_color }};
    --lxhr-surface: {{ section.settings.surface_color }};
    --lxhr-text: {{ section.settings.text_color }};
    --lxhr-muted: {{ section.settings.muted_color }};
    --lxhr-border: {{ section.settings.border_color }};
    --lxhr-radius: {{ section.settings.radius }}px;
    --lxhr-max: {{ section.settings.page_width }}px;
    --lxhr-space: {{ section.settings.section_spacing }}px;
  "
>
  <div class="lxhr-wrap">
    <div class="lxhr-section">
      <div class="lxhr-center">
        {% if section.settings.eyebrow != blank %}
          <div class="lxhr-eyebrow">{{ section.settings.eyebrow }}</div>
        {% endif %}
        <h2 class="lxhr-title">{{ section.settings.title }}</h2>
        {% if section.settings.subtitle != blank %}
          <div class="lxhr-subtitle">{{ section.settings.subtitle }}</div>
        {% endif %}
      </div>

      <div class="lxhr-faq">
        {% for block in section.blocks %}
          <details class="lxhr-faq-item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <div class="lxhr-faq-answer">{{ block.settings.answer }}</div>
          </details>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luxo Hair Removal FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Preguntas frecuentes"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Resuelve objeciones antes de comprar"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Esta sección ayuda a eliminar dudas antes del clic final. Ajusta las respuestas a tu operación real."
    },
    {
      "type": "range",
      "id": "page_width",
      "label": "Ancho máximo",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1120
    },
    {
      "type": "range",
      "id": "section_spacing",
      "label": "Espaciado",
      "min": 40,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Radio",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo",
      "default": "#fbf5f4"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "Tarjeta",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto principal",
      "default": "#1b1718"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Texto secundario",
      "default": "#6d6265"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borde",
      "default": "#eadfdf"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Pregunta",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pregunta",
          "default": "Pregunta frecuente"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Respuesta",
          "default": "Escribe aquí la respuesta real."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxo Hair Removal FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "¿Cuántas unidades incluye este pack?",
            "answer": "Incluye 5 cremas depiladoras dentro de la misma compra."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "¿Cómo se usa correctamente?",
            "answer": "Sigue únicamente las indicaciones oficiales del producto, respetando tiempos y modo de retiro."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "¿Qué opciones de pago están disponibles?",
            "answer": "La tienda usa Shopify Payments y puede mostrar cuotas, pagos express u otras opciones según la configuración activa."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "¿Dónde puedo ver más detalles del producto?",
            "answer": "Desde el botón de compra puedes ir directamente a la URL del producto para revisar detalles completos y agregarlo al carrito."
          }
        }
      ]
    }
  ]
}
{% endschema %}