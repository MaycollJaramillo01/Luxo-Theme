{% comment %}
  Luxo — Landing 4 de Julio PRO · Hero responsive + grid editorial de productos
  ------------------------------------------------------------------------
  Una sola colección. Zona central = productos de esa colección.

  VARIANTES PROFESIONALES (arreglo del desorden de tallas):
    - Color y Talla se muestran en filas separadas y limpias.
    - "Color": swatches de colores ÚNICOS (con imagen).
    - "Talla": pills de tallas ÚNICAS; las agotadas salen tachadas.
    - Selección tipo matriz: color + talla -> variante real (precio,
      stock, imagen y botón se actualizan solos).
    - Detecta el nombre real de cada opción para las etiquetas.

  Robustez:
    - .j4-reveal es FAIL-SAFE (visible por defecto; el JS solo anima).
    - Resolución de colección simple y mensajes claros en el editor.

  Nota: el descuento visual global solo cambia cómo se ven los precios aquí.
        El descuento real se configura en Shopify (código/precio comparativo).
{% endcomment %}

{%- assign sid = 'Luxo4Jul-' | append: section.id -%}
{%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..600&family=Hanken+Grotesk:wght@400;500;600;700&display=swap">

<div
  id="{{ sid }}"
  class="j4"
  style="
    --j4-bg: {{ section.settings.bg_color }};
    --j4-surface: {{ section.settings.surface_color }};
    --j4-text: {{ section.settings.text_color }};
    --j4-muted: {{ section.settings.muted_color }};
    --j4-red: {{ section.settings.red_color }};
    --j4-navy: {{ section.settings.navy_color }};
    --j4-gold: {{ section.settings.gold_color }};
    --j4-cream: {{ section.settings.cream_color }};
    --j4-radius: {{ section.settings.card_radius }}px;
    --j4-gap: {{ section.settings.gap }}px;
    --j4-pt: {{ section.settings.padding_top }}px;
    --j4-pb: {{ section.settings.padding_bottom }}px;
    --j4-maxw: {{ section.settings.container_width }}px;
    --j4-ratio: {{ section.settings.card_ratio }};
    --j4-fit: {{ section.settings.image_fit }};
    --hero-minh-d: {{ section.settings.hero_min_height_desktop }}px;
    --hero-minh-m: {{ section.settings.hero_min_height_mobile }}px;
    --hero-overlay: {{ section.settings.hero_overlay | divided_by: 100.0 }};
    --hero-desktop-position: {{ section.settings.hero_desktop_position }};
    --hero-mobile-position: {{ section.settings.hero_mobile_position }};
  "
>

  {%- comment -%} ── ZONA 1 · HERO RESPONSIVE SIN TEXTO ── {%- endcomment -%}
  {%- if section.settings.show_hero -%}
    {%- liquid
      assign hero_desktop = section.settings.hero_image
      assign hero_mobile = section.settings.hero_image_mobile
      if hero_mobile == blank
        assign hero_mobile = hero_desktop
      endif
      if hero_desktop == blank
        assign hero_desktop = hero_mobile
      endif
    -%}

    <section class="j4__hero" style="--hero-bg: {{ section.settings.hero_bg_color }};">
      {%- if section.settings.hero_link != blank -%}
        <a class="j4__hero__link" href="{{ section.settings.hero_link }}" aria-label="{{ section.settings.hero_link_label | escape }}">
      {%- endif -%}

      {%- if hero_desktop != blank -%}
        <picture class="j4__hero__picture">
          {%- if hero_mobile != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ hero_mobile | image_url: width: 480 }} 480w,
                {{ hero_mobile | image_url: width: 640 }} 640w,
                {{ hero_mobile | image_url: width: 750 }} 750w,
                {{ hero_mobile | image_url: width: 960 }} 960w,
                {{ hero_mobile | image_url: width: 1200 }} 1200w
              "
              sizes="100vw"
            >
          {%- endif -%}
          {{
            hero_desktop
            | image_url: width: 2600
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              class: 'j4__hero__img',
              sizes: '100vw',
              widths: '900,1200,1600,2000,2400,2600',
              alt: section.settings.hero_alt
          }}
        </picture>
      {%- else -%}
        <div class="j4__hero__placeholder">
          {%- if request.design_mode -%}
            <span>Selecciona la imagen del hero para desktop y mobile.</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.hero_overlay > 0 -%}
        <span class="j4__hero__overlay" aria-hidden="true"></span>
      {%- endif -%}

      {%- if section.settings.hero_link != blank -%}
        </a>
      {%- endif -%}
    </section>
  {%- endif -%}

  {%- comment -%} ── ZONA 2 · BARRA PROMOCIONAL ── {%- endcomment -%}
  {%- if section.settings.show_promo_bar and section.settings.promo_text != blank -%}
    <div class="j4__promobar" style="--promo-bg: {{ section.settings.promo_bg }}; --promo-color: {{ section.settings.promo_color }};">
      <div class="j4__promobar__track">
        <div class="j4__promobar__item">
          <span class="j4__dot" aria-hidden="true"></span>
          <span>{{ section.settings.promo_text }}</span>
          <span class="j4__dot" aria-hidden="true"></span>
        </div>
        <div class="j4__promobar__item" aria-hidden="true">
          <span class="j4__dot"></span>
          <span>{{ section.settings.promo_text }}</span>
          <span class="j4__dot"></span>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ── ZONA 3 · PRODUCTOS DE LA COLECCIÓN ── {%- endcomment -%}
  <section class="j4__shop" id="j4-coleccion">
    <div class="j4__container">
      {%- liquid
        assign col = section.settings.collection
        if col == blank and collection != blank
          assign col = collection
        endif
      -%}

      {%- if section.settings.collections_heading != blank or section.settings.collections_subheading != blank -%}
        <header class="j4__head j4-reveal">
          {%- if section.settings.collections_eyebrow != blank -%}
            <p class="j4__head__eyebrow">
              <span></span>{{ section.settings.collections_eyebrow }}<span></span>
            </p>
          {%- endif -%}
          {%- if section.settings.collections_heading != blank -%}
            <h2 class="j4__head__title">{{ section.settings.collections_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.collections_subheading != blank -%}
            <p class="j4__head__sub">{{ section.settings.collections_subheading }}</p>
          {%- endif -%}
        </header>
      {%- endif -%}

      {%- if col != blank and col.products_count > 0 -%}
        {%- assign global_discount = section.settings.global_discount -%}

        <ul class="j4__grid j4__grid--{{ section.settings.grid_style }}" role="list">
          {%- for product in col.products limit: section.settings.max_products -%}
            {%- liquid
              assign cv = product.selected_or_first_available_variant
              if cv == blank
                assign cv = product.first_available_variant
              endif
              if cv == blank
                assign cv = product.variants.first
              endif

              assign has_variants = false
              unless product.has_only_default_variant
                assign has_variants = true
              endunless

              assign cv_available = false
              if cv != blank
                assign cv_available = cv.available
              elsif product.available
                assign cv_available = true
              endif

              assign price_raw = cv.price | default: product.price_min
              assign compare_raw = blank
              if cv.compare_at_price != blank and cv.compare_at_price > price_raw
                assign compare_raw = cv.compare_at_price
              elsif product.compare_at_price_max != blank and product.compare_at_price_max > price_raw
                assign compare_raw = product.compare_at_price_max
              endif

              assign price_text = price_raw | money
              assign compare_text = ''
              if compare_raw != blank
                assign compare_text = compare_raw | money
              endif

              if global_discount > 0 and price_raw != blank
                assign disc_mult = 100 | minus: global_discount | divided_by: 100.0
                assign sale_price = price_raw | times: disc_mult
                assign price_text = sale_price | money
                assign compare_text = price_raw | money
              endif

              assign cv_img = blank
              if cv.featured_media != blank
                assign cv_img = cv.featured_media.preview_image
              elsif cv.image != blank
                assign cv_img = cv.image
              elsif product.featured_media != blank
                assign cv_img = product.featured_media.preview_image
              endif

              comment
                Detección de opciones de color y talla por su nombre real.
              endcomment
              assign color_pos = 0
              assign size_pos = 0
              for option in product.options_with_values
                assign on = option.name | downcase
                if on contains 'color' or on contains 'colour' or on contains 'tono'
                  assign color_pos = forloop.index
                elsif on contains 'talla' or on contains 'size' or on contains 'tamaño' or on contains 'tamano' or on contains 'medida'
                  assign size_pos = forloop.index
                endif
              endfor
              if color_pos == 0 and size_pos == 0 and has_variants
                assign size_pos = 1
              endif

              assign opt_color = blank
              assign opt_size = blank
              if color_pos > 0
                assign cidx = color_pos | minus: 1
                assign opt_color = product.options_with_values[cidx]
              endif
              if size_pos > 0
                assign sidx = size_pos | minus: 1
                assign opt_size = product.options_with_values[sidx]
              endif

              assign init_color = ''
              case color_pos
                when 1
                  assign init_color = cv.option1
                when 2
                  assign init_color = cv.option2
                when 3
                  assign init_color = cv.option3
              endcase
              assign init_size = ''
              case size_pos
                when 1
                  assign init_size = cv.option1
                when 2
                  assign init_size = cv.option2
                when 3
                  assign init_size = cv.option3
              endcase

              assign tile_class = 'j4__pitem'
              assign tile_mod = forloop.index0 | modulo: 10
              if section.settings.grid_style == 'editorial'
                if forloop.index == 1 or tile_mod == 6
                  assign tile_class = tile_class | append: ' j4__pitem--feature'
                elsif tile_mod == 3 or tile_mod == 8
                  assign tile_class = tile_class | append: ' j4__pitem--wide'
                endif
              endif
            -%}

            <li class="{{ tile_class }} j4-reveal" role="listitem">
              <article class="j4__pcard" data-product-card data-product-url="{{ product.url }}" data-color-pos="{{ color_pos }}" data-size-pos="{{ size_pos }}">

                <a class="j4__pcard__media-link" href="{{ product.url }}?variant={{ cv.id }}" aria-label="{{ product.title | escape }}" data-product-link tabindex="-1">
                  <div class="j4__pcard__media">
                    {%- if cv_img != blank -%}
                      <img
                        class="j4__pcard__img"
                        src="{{ cv_img | image_url: width: 900 }}"
                        srcset="{{ cv_img | image_url: width: 450 }} 450w, {{ cv_img | image_url: width: 700 }} 700w, {{ cv_img | image_url: width: 900 }} 900w, {{ cv_img | image_url: width: 1200 }} 1200w"
                        sizes="(max-width: 749px) 50vw, 25vw"
                        width="{{ cv_img.width }}"
                        height="{{ cv_img.height }}"
                        alt="{{ cv_img.alt | default: product.title | escape }}"
                        loading="lazy"
                        data-main-image
                      >
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'j4__pcard__img j4__pcard__img--placeholder' }}
                    {%- endif -%}

                    {%- if section.settings.show_badges -%}
                      <div class="j4__pbadges">
                        {%- if product.available == false -%}
                          <span class="j4__pbadge j4__pbadge--out">{{ section.settings.badge_soldout }}</span>
                        {%- elsif compare_text != blank -%}
                          <span class="j4__pbadge j4__pbadge--sale">{{ section.settings.badge_sale }}</span>
                        {%- elsif section.settings.new_tag != blank and product.tags contains section.settings.new_tag -%}
                          <span class="j4__pbadge j4__pbadge--new">{{ section.settings.badge_new }}</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}

                    {%- if global_discount > 0 and product.available -%}
                      <span class="j4__corner-badge">-{{ global_discount }}%</span>
                    {%- endif -%}
                  </div>
                </a>

                <div class="j4__pcard__body">
                  <div class="j4__pcard__top">
                    <a class="j4__pcard__title" href="{{ product.url }}?variant={{ cv.id }}" data-product-link>{{ product.title }}</a>

                    <div class="j4__pcard__price{% if compare_text != blank %} is-sale{% endif %}" data-price-wrap>
                      <span class="j4__price j4__price--now" data-price-current>{{ price_text }}</span>
                      <s class="j4__price j4__price--was{% if compare_text == blank %} is-hidden{% endif %}" data-price-compare>{{ compare_text }}</s>
                    </div>
                  </div>

                  {%- comment -%} COLOR (swatches únicos) {%- endcomment -%}
                  {%- if section.settings.show_swatches and opt_color != blank and opt_color.values.size > 1 -%}
                    <div class="j4__opt">
                      <span class="j4__opt-label">{{ opt_color.name }}</span>
                      <div class="j4__swatch-row" role="group" aria-label="{{ opt_color.name | escape }}">
                        {%- for cval in opt_color.values -%}
                          {%- liquid
                            assign rep_img = blank
                            for v in product.variants
                              assign vc = v.option1
                              case color_pos
                                when 2
                                  assign vc = v.option2
                                when 3
                                  assign vc = v.option3
                              endcase
                              if vc == cval and rep_img == blank
                                assign vm = v.featured_media | default: v.image
                                if vm != blank
                                  assign rep_img = vm.preview_image | default: vm
                                endif
                              endif
                            endfor
                          -%}
                          <button
                            type="button"
                            class="j4__swatch{% if cval == init_color %} active{% endif %}"
                            data-color="{{ cval | escape }}"
                            {% if rep_img != blank %}data-img="{{ rep_img | image_url: width: 900 }}"{% endif %}
                            title="{{ cval | escape }}"
                            aria-label="{{ cval | escape }}"
                          >
                            {%- if rep_img != blank -%}
                              <img src="{{ rep_img | image_url: width: 96 }}" alt="{{ cval | escape }}" width="96" height="96" loading="lazy">
                            {%- else -%}
                              <span class="j4__swatch-fallback"></span>
                            {%- endif -%}
                          </button>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endif -%}

                  {%- comment -%} TALLA (pills únicos) {%- endcomment -%}
                  {%- if section.settings.show_chips and opt_size != blank and opt_size.values.size > 1 -%}
                    <div class="j4__opt">
                      <span class="j4__opt-label">{{ opt_size.name }}</span>
                      <div class="j4__size-row" role="group" aria-label="{{ opt_size.name | escape }}">
                        {%- for sval in opt_size.values -%}
                          <button
                            type="button"
                            class="j4__size{% if sval == init_size %} active{% endif %}"
                            data-size="{{ sval | escape }}"
                            aria-label="{{ opt_size.name | escape }} {{ sval | escape }}"
                          >{{ sval }}</button>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endif -%}

                  {%- if section.settings.show_atc -%}
                    <form class="j4__pform" method="post" action="/cart/add" data-product-form>
                      <input type="hidden" name="id" value="{{ cv.id }}" data-variant-input>
                      <button
                        type="submit"
                        class="j4__btn j4__btn--navy j4__atc{% unless cv_available %} j4__atc--disabled{% endunless %}"
                        {% unless cv_available %}disabled{% endunless %}
                        data-atc-button
                      >
                        {%- if cv_available -%}{{ section.settings.atc_label | default: 'Agregar al carrito' }}{%- else -%}{{ section.settings.badge_soldout }}{%- endif -%}
                      </button>
                    </form>
                  {%- endif -%}
                </div>

                {%- if has_variants -%}
                  <script type="application/json" data-variant-data>[
                    {%- for v in product.variants -%}
                      {%- liquid
                        assign vnow = v.price | money
                        assign vcmp = ''
                        if global_discount > 0
                          assign vd = 100 | minus: global_discount | divided_by: 100.0
                          assign vcalc = v.price | times: vd
                          assign vnow = vcalc | money
                          assign vcmp = v.price | money
                        elsif v.compare_at_price != blank and v.compare_at_price > v.price
                          assign vcmp = v.compare_at_price | money
                        endif
                        assign vm = v.featured_media | default: v.image
                        assign vimg = ''
                        if vm != blank
                          assign vpre = vm.preview_image | default: vm
                          assign vimg = vpre | image_url: width: 900
                        endif
                      -%}
                      {"id":{{ v.id }},"available":{{ v.available }},"o1":{{ v.option1 | json }},"o2":{{ v.option2 | json }},"o3":{{ v.option3 | json }},"price":{{ vnow | json }},"compare":{{ vcmp | json }},"img":{{ vimg | json }}}{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}
                  ]</script>
                {%- endif -%}

              </article>
            </li>
          {%- endfor -%}
        </ul>

        {%- if section.settings.show_view_all -%}
          <div class="j4__viewall-wrap j4-reveal">
            <a class="j4__btn j4__btn--outline" href="{{ col.url }}">
              {{ section.settings.view_all_label | default: 'Ver toda la colección' }}
              <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        {%- endif -%}

      {%- elsif request.design_mode -%}
        <div class="j4__empty">
          {%- if col != blank -%}
            <p>La colección <strong>{{ col.title }}</strong> está seleccionada, pero no tiene productos para mostrar.</p>
            <p class="j4__empty__hint">Revisa que los productos estén <strong>activos</strong>, publicados en el canal <strong>Tienda online</strong> y que realmente pertenezcan a esa colección.</p>
          {%- else -%}
            <p>Selecciona la <strong>colección del 4 de Julio</strong> en los ajustes de la sección (campo “Colección a mostrar”).</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ── ZONA 4 · BENEFICIOS ── {%- endcomment -%}
  {%- if section.settings.show_benefits and benefit_blocks.size > 0 -%}
    <section class="j4__benefits">
      <div class="j4__container">
        <ul class="j4__benefits__grid" role="list">
          {%- for block in benefit_blocks -%}
            <li class="j4__benefit j4-reveal" {{ block.shopify_attributes }}>
              <span class="j4__benefit__icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'truck' -%}<svg width="26" height="26" viewBox="0 0 32 32" fill="none"><rect x="2" y="8" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M22 12h5l3 6v4h-8V12Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="8" cy="25" r="2.5" stroke="currentColor" stroke-width="1.8"/><circle cx="24" cy="25" r="2.5" stroke="currentColor" stroke-width="1.8"/></svg>
                  {%- when 'shield' -%}<svg width="26" height="26" viewBox="0 0 32 32" fill="none"><path d="M16 3 5 7.5V16c0 5.5 4.8 10.7 11 12 6.2-1.3 11-6.5 11-12V7.5L16 3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                  {%- when 'tag' -%}<svg width="26" height="26" viewBox="0 0 32 32" fill="none"><path d="M4 4h11l13 13-11 11L4 15V4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="10" cy="10" r="2" fill="currentColor"/></svg>
                  {%- when 'gift' -%}<svg width="26" height="26" viewBox="0 0 32 32" fill="none"><rect x="4" y="13" width="24" height="16" rx="2" stroke="currentColor" stroke-width="1.8"/><rect x="2" y="8" width="28" height="5" rx="1.5" stroke="currentColor" stroke-width="1.8"/><path d="M16 8V29" stroke="currentColor" stroke-width="1.8"/></svg>
                  {%- when 'heart' -%}<svg width="26" height="26" viewBox="0 0 32 32" fill="none"><path d="M16 27S4 20 4 11.5A7.5 7.5 0 0 1 16 7a7.5 7.5 0 0 1 12 4.5C28 20 16 27 16 27Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                  {%- when 'star' -%}<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.8 5.9 20.4l1.4-6.8L2.2 9l6.9-.7L12 2z"/></svg>
                  {%- else -%}<svg width="26" height="26" viewBox="0 0 32 32" fill="none"><circle cx="16" cy="16" r="12" stroke="currentColor" stroke-width="1.8"/><path d="M10 16l4.5 4.5 8-8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- endcase -%}
              </span>
              <div class="j4__benefit__copy">
                <h4 class="j4__benefit__title">{{ block.settings.title }}</h4>
                {%- if block.settings.text != blank -%}<p class="j4__benefit__text">{{ block.settings.text }}</p>{%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ── ZONA 5 · CTA FINAL ── {%- endcomment -%}
  {%- if section.settings.show_final_cta -%}
    <section class="j4__final" style="--final-bg: {{ section.settings.final_bg }}; --final-text: {{ section.settings.final_text }};">
      <div class="j4__container j4__final__inner j4-reveal">
        {%- if section.settings.final_eyebrow != blank -%}<p class="j4__final__eyebrow">{{ section.settings.final_eyebrow }}</p>{%- endif -%}
        {%- if section.settings.final_heading != blank -%}<h2 class="j4__final__heading">{{ section.settings.final_heading }}</h2>{%- endif -%}
        {%- if section.settings.final_sub != blank -%}<p class="j4__final__sub">{{ section.settings.final_sub }}</p>{%- endif -%}
        {%- if section.settings.final_cta_label != blank -%}
          <div class="j4__final__btns">
            <a href="{{ section.settings.final_cta_url | default: '#j4-coleccion' }}" class="j4__btn j4__btn--white">{{ section.settings.final_cta_label }}</a>
          </div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

</div>

<style>
  #{{ sid }} {
    --j4-font-head: "Bodoni Moda", Georgia, "Times New Roman", serif;
    --j4-font-body: "Hanken Grotesk", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: var(--j4-bg);
    color: var(--j4-text);
    font-family: var(--j4-font-body);
    -webkit-font-smoothing: antialiased;
    overflow: hidden;
  }
  #{{ sid }} *, #{{ sid }} *::before, #{{ sid }} *::after { box-sizing: border-box; }
  #{{ sid }} .j4__container { max-width: var(--j4-maxw); margin: 0 auto; padding: 0 2.4rem; }
  @media (max-width: 749px) { #{{ sid }} .j4__container { padding: 0 1.4rem; } }

