<script>
  (function () {
    var ATC_LABEL = {{ section.settings.atc_label | default: 'Agregar al carrito' | json }};
    var SOLD_LABEL = {{ section.settings.badge_soldout | default: 'Agotado' | json }};

    function initCard(card) {
      if (card._j4Init) return;
      card._j4Init = true;

      var variants = [];
      var dataEl = card.querySelector('[data-variant-data]');
      if (dataEl) { try { variants = JSON.parse(dataEl.textContent); } catch (e) { variants = []; } }

      var colorPos = parseInt(card.getAttribute('data-color-pos') || '0', 10);
      var sizePos = parseInt(card.getAttribute('data-size-pos') || '0', 10);
      var baseUrl = card.getAttribute('data-product-url') || '#';

      var mainImg = card.querySelector('[data-main-image]');
      var varInput = card.querySelector('[data-variant-input]');
      var priceWrap = card.querySelector('[data-price-wrap]');
      var priceNow = card.querySelector('[data-price-current]');
      var priceWas = card.querySelector('[data-price-compare]');
      var atcBtn = card.querySelector('[data-atc-button]');
      var links = card.querySelectorAll('[data-product-link]');
      var swatches = card.querySelectorAll('[data-color]');
      var sizes = card.querySelectorAll('[data-size]');

      if (!variants.length) return;

      function optVal(v, pos) { return pos === 1 ? v.o1 : pos === 2 ? v.o2 : pos === 3 ? v.o3 : null; }

      var state = { color: null, size: null };
      var aSw = card.querySelector('[data-color].active');
      if (aSw) state.color = aSw.getAttribute('data-color');
      var aSz = card.querySelector('[data-size].active');
      if (aSz) state.size = aSz.getAttribute('data-size');

      function matchVariant() {
        for (var i = 0; i < variants.length; i++) {
          var v = variants[i];
          var okC = !colorPos || optVal(v, colorPos) === state.color;
          var okS = !sizePos || optVal(v, sizePos) === state.size;
          if (okC && okS) return v;
        }
        return null;
      }
      function sizeAvailable(sz) {
        for (var i = 0; i < variants.length; i++) {
          var v = variants[i];
          if (optVal(v, sizePos) === sz && (!colorPos || optVal(v, colorPos) === state.color) && v.available) return true;
        }
        return false;
      }
      function firstAvailableSize() {
        for (var i = 0; i < variants.length; i++) {
          var v = variants[i];
          if ((!colorPos || optVal(v, colorPos) === state.color) && v.available) return optVal(v, sizePos);
        }
        return state.size;
      }

      function render() {
        swatches.forEach(function (b) { b.classList.toggle('active', b.getAttribute('data-color') === state.color); });
        if (sizePos) {
          sizes.forEach(function (b) {
            var sz = b.getAttribute('data-size');
            b.classList.toggle('is-soldout', !sizeAvailable(sz));
            b.classList.toggle('active', sz === state.size);
          });
        }
        var v = matchVariant();
        if (!v) return;
        if (varInput) varInput.value = v.id;
        if (priceNow && v.price) priceNow.textContent = v.price;
        if (priceWas && priceWrap) {
          if (v.compare) {
            priceWas.textContent = v.compare;
            priceWas.classList.remove('is-hidden');
            priceWrap.classList.add('is-sale');
          } else {
            priceWas.textContent = '';
            priceWas.classList.add('is-hidden');
            priceWrap.classList.remove('is-sale');
          }
        }
        if (mainImg && v.img) { mainImg.src = v.img; mainImg.removeAttribute('srcset'); }
        links.forEach(function (l) { l.href = baseUrl + '?variant=' + v.id; });
        if (atcBtn) {
          atcBtn.disabled = !v.available;
          atcBtn.classList.toggle('j4__atc--disabled', !v.available);
          atcBtn.textContent = v.available ? ATC_LABEL : SOLD_LABEL;
        }
      }

      swatches.forEach(function (b) {
        b.addEventListener('click', function () {
          state.color = b.getAttribute('data-color');
          var im = b.getAttribute('data-img');
          if (mainImg && im) { mainImg.src = im; mainImg.removeAttribute('srcset'); }
          if (sizePos && !sizeAvailable(state.size)) { state.size = firstAvailableSize(); }
          render();
        });
      });
      sizes.forEach(function (b) {
        b.addEventListener('click', function () {
          state.size = b.getAttribute('data-size');
          render();
        });
      });

      render();
    }

    function init(sectionId) {
      var root = document.getElementById('Luxo4Jul-' + sectionId);
      if (!root) return;

      root.querySelectorAll('[data-product-card]').forEach(initCard);

      var reveals = root.querySelectorAll('.j4-reveal');
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && 'IntersectionObserver' in window && reveals.length) {
        root.classList.add('j4--anim');
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -6% 0px' });
        reveals.forEach(function (el) { io.observe(el); });
        setTimeout(function () { reveals.forEach(function (el) { el.classList.add('is-visible'); }); }, 1600);
      }
    }

    document.addEventListener('DOMContentLoaded', function () { init('{{ section.id }}'); });
    if (document.readyState !== 'loading') { init('{{ section.id }}'); }
    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') init('{{ section.id }}');
    });
  })();
</script>

