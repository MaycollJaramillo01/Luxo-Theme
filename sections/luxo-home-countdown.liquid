    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo",
      "default": "#f8f1f3"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "Fondo de numeros",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto principal",
      "default": "#171313"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Texto secundario",
      "default": "#665b5d"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color acento",
      "default": "#b87386"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Bordes",
      "default": "#e7d6db"
    },
    {
      "type": "color",
      "id": "live_bg_color",
      "label": "Fondo cuando esta activo",
      "default": "#211718"
    },
    {
      "type": "color",
      "id": "live_text_color",
      "label": "Texto cuando esta activo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "live_muted_color",
      "label": "Texto secundario activo",
      "default": "#f2dce2"
    }
  ],
  "presets": [
    {
      "name": "Luxo home countdown"
    }
  ]
}
{% endschema %}
