<section
  id="luxo-bottom-{{ section.id }}"
  class="luxo-bottom-cta{% if section.settings.image != blank %} luxo-bottom-cta--has-image{% endif %}"
  style="
    --lb-dark: {{ section.settings.dark_color }};
    --lb-border: {{ section.settings.border_color }};
    --lb-muted: {{ section.settings.muted_color }};
  "
>
  <div class="luxo-bottom-cta__band">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2600 | image_tag:
        class: 'luxo-bottom-cta__media',
        widths: '750, 1100, 1500, 2000, 2600',
        sizes: '100vw',
        loading: 'lazy',
        alt: ''
      }}
      <span class="luxo-bottom-cta__overlay" aria-hidden="true"></span>
    {%- endif -%}
    <div class="luxo-bottom-cta__inner">
      {%- if section.settings.kicker != blank -%}
        <p class="luxo-bottom-cta__kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.final_title != blank -%}
        <h2 class="luxo-bottom-cta__title">{{ section.settings.final_title | newline_to_br }}</h2>
      {%- endif -%}
      {%- if section.settings.final_text != blank -%}
        <div class="luxo-bottom-cta__text">{{ section.settings.final_text }}</div>
      {%- endif -%}
      {%- if section.settings.final_primary_label != blank -%}
        <a href="{{ section.settings.final_primary_url | default: '#' }}" class="luxo-bottom-cta__button">
          <span>{{ section.settings.final_primary_label }}</span>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_inner_footer -%}
    <div class="luxo-bottom-cta__footer">
      <div class="luxo-bottom-cta__footer-row">
        <div>
          {%- if section.settings.footer_brand_name != blank -%}
            <p class="luxo-bottom-cta__footer-brand">{{ section.settings.footer_brand_name }}</p>
          {%- endif -%}
          {%- if section.settings.footer_copy != blank -%}
            <p class="luxo-bottom-cta__footer-copy">{{ section.settings.footer_copy }}</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.show_sticky_mobile_cta -%}
    <div class="luxo-bottom-cta__sticky">
      <a href="{{ section.settings.sticky_mobile_url | default: '#' }}" class="luxo-bottom-cta__sticky-button">
        {{ section.settings.sticky_mobile_label }}
      </a>
    </div>
  {%- endif -%}
</section>

{%- style -%}
  .luxo-bottom-cta__band {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--lb-dark);
    color: var(--luxo-white);
    text-align: center;
  }

  .luxo-bottom-cta__media {
    position: absolute;
    z-index: -2;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .luxo-bottom-cta__overlay {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.32), var(--lb-dark) 92%);
  }

  .luxo-bottom-cta__inner {
    width: min(100% - 48px, 760px);
    margin: 0 auto;
    padding: 96px 0;
  }

  .luxo-bottom-cta--has-image .luxo-bottom-cta__inner {
    padding: 140px 0 120px;
  }

  .luxo-bottom-cta__kicker {
    margin: 0 0 16px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .luxo-bottom-cta__title {
    margin: 0 0 18px;
    color: var(--luxo-white);
    font-size: clamp(3.4rem, 5vw, 6.4rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .luxo-bottom-cta__text {
    max-width: 52ch;
    margin: 0 auto 32px;
    color: rgba(255, 255, 255, 0.76);
    font-size: 1.5rem;
    line-height: 1.6;
  }

  .luxo-bottom-cta__text p {
    margin: 0;
  }

  .luxo-bottom-cta__button {
    display: inline-flex;
    min-height: 54px;
    align-items: center;
    gap: 12px;
    padding: 0 30px;
    border: 1px solid var(--luxo-white);
    color: var(--lb-dark);
    background: var(--luxo-white);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 220ms ease, background 220ms ease;
  }

  .luxo-bottom-cta__button svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-width: 1.5;
    transition: transform 220ms ease;
  }

  .luxo-bottom-cta__button:hover {
    color: var(--luxo-white);
    background: transparent;
  }

  .luxo-bottom-cta__button:hover svg {
    transform: translateX(3px);
  }

  .luxo-bottom-cta__footer {
    border-top: 1px solid var(--lb-border);
    background: rgba(255, 255, 255, 0.42);
    padding: 20px 0;
  }

  .luxo-bottom-cta__footer-row {
    width: min(100% - 48px, 1280px);
    margin: 0 auto;
  }

  .luxo-bottom-cta__footer-brand {
    margin: 0;
    font-size: 1.5rem;
  }

  .luxo-bottom-cta__footer-copy {
    margin: 5px 0 0;
    color: var(--lb-muted);
    font-size: 1rem;
  }

  .luxo-bottom-cta__sticky {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .luxo-bottom-cta__inner {
      width: min(100% - 32px, 760px);
      padding: 64px 0;
    }

    .luxo-bottom-cta--has-image .luxo-bottom-cta__inner {
      padding: 100px 0 84px;
    }

    .luxo-bottom-cta__sticky {
      position: fixed;
      z-index: 50;
      inset: auto 0 0;
      display: block;
      padding: 15px;
      border-top: 1px solid var(--lb-border);
      background: var(--luxo-white);
      text-align: center;
    }

    .luxo-bottom-cta__sticky-button {
      display: flex;
      width: 100%;
      min-height: 48px;
      align-items: center;
      justify-content: center;
      color: var(--luxo-white);
      background: var(--lb-dark);
      font-size: 1.15rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-decoration: none;
      text-transform: uppercase;
    }
  }

  {%- if section.settings.show_sticky_mobile_cta -%}
    @media screen and (max-width: 749px) {
      body { padding-bottom: 78px; }
    }
  {%- endif -%}
{%- endstyle -%}

{% schema %}
{
  "name": "Luxo - Footer & CTA",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen de fondo", "info": "Opcional. Sin imagen se usa el color de fondo." },
    { "type": "text", "id": "kicker", "label": "Antetítulo" },
    { "type": "textarea", "id": "final_title", "label": "Título CTA", "default": "No necesitas esperar" },
    { "type": "richtext", "id": "final_text", "label": "Texto CTA" },
    { "type": "text", "id": "final_primary_label", "label": "Botón principal", "default": "QUIERO MI FAJA" },
    { "type": "url", "id": "final_primary_url", "label": "URL principal" },
    { "type": "checkbox", "id": "show_inner_footer", "label": "Mostrar footer interno", "default": true },
    { "type": "text", "id": "footer_brand_name", "label": "Marca footer", "default": "Luxo Boutique" },
    { "type": "text", "id": "footer_copy", "label": "Texto legal" },
    { "type": "checkbox", "id": "show_sticky_mobile_cta", "label": "Mostrar CTA Sticky (Móvil)", "default": true },
    { "type": "text", "id": "sticky_mobile_label", "label": "Texto botón sticky", "default": "COMPRAR AHORA" },
    { "type": "url", "id": "sticky_mobile_url", "label": "URL botón sticky" },
    { "type": "color", "id": "dark_color", "label": "Color oscuro fondo", "default": "#13110f" },
    { "type": "color", "id": "border_color", "label": "Color bordes", "default": "#ddd5cb" },
    { "type": "color", "id": "muted_color", "label": "Texto secundario", "default": "#6f675d" }
  ],
  "presets": [{"name": "Luxo - Footer & CTA"}]
}
{% endschema %}
