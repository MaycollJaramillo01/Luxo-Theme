<section class="luxo-categories" aria-label="{{ section.settings.heading | escape }}">
  {%- if section.settings.heading != blank -%}<h2 class="visually-hidden">{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="luxo-categories__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign intent_collection = block.settings.collection
        assign intent_image = block.settings.image
        if intent_image == blank and intent_collection.image != blank
          assign intent_image = intent_collection.image
        endif
        if intent_image == blank and intent_collection.products.first.featured_media != blank
          assign intent_image = intent_collection.products.first.featured_media.preview_image
        endif
        assign intent_link = block.settings.link | default: intent_collection.url | default: routes.all_products_collection_url
        assign intent_title = block.settings.title | default: intent_collection.title
      -%}
      <a
        class="luxo-category"
        href="{{ intent_link }}"
        style="--luxo-category-position: {{ block.settings.image_position | default: 'center top' }};"
        {{ block.shopify_attributes }}
      >
        <span class="luxo-category__media">
          {%- if intent_image != blank -%}
            {{ intent_image | image_url: width: 1200 | image_tag:
              widths: '420, 640, 840, 1200',
              sizes: '(max-width: 749px) 78vw, 25vw',
              loading: 'lazy',
              alt: intent_image.alt | default: intent_title
            }}
          {%- else -%}
            <span class="luxo-category__empty" aria-hidden="true"></span>
          {%- endif -%}
        </span>
        <span class="luxo-category__label"><span>{{ intent_title | escape }}</span><span aria-hidden="true">→</span></span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Luxo — Categorías",
  "settings": [
    { "type": "text", "id": "heading", "label": "Nombre accesible", "default": "Comprar por categoría" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "image_picker", "id": "image", "label": "Imagen alternativa" },
        {
          "type": "select",
          "id": "image_position",
          "label": "Encuadre de la imagen",
          "info": "Ajusta el recorte si la foto queda incompleta (por ejemplo, si corta la cabeza).",
          "default": "center top",
          "options": [
            { "value": "center top", "label": "Arriba" },
            { "value": "center center", "label": "Centro" },
            { "value": "center bottom", "label": "Abajo" }
          ]
        },
        { "type": "text", "id": "title", "label": "Título alternativo", "default": "FAJAS" },
        { "type": "url", "id": "link", "label": "Enlace alternativo" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Luxo — Categorías",
      "blocks": [
        { "type": "category", "settings": { "title": "FAJAS" } },
        { "type": "category", "settings": { "title": "ROPA" } },
        { "type": "category", "settings": { "title": "POSTPARTO" } },
        { "type": "category", "settings": { "title": "BIENESTAR" } }
      ]
    }
  ]
}
{% endschema %}
