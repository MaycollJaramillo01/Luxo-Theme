<script>
  function initLuxReels(sectionId) {
    const section = document.querySelector('#LuxReels-' + sectionId);
    if (!section || section.dataset.initialized === 'true') return;

    section.dataset.initialized = 'true';

    const track = section.querySelector('.lux-reels__track');
    const btnNext = section.querySelector('.lux-carousel-btn--next');
    const btnPrev = section.querySelector('.lux-carousel-btn--prev');
    const cards = section.querySelectorAll('.lux-reel-card');
    const modals = section.querySelectorAll('.lux-modal');
    const closeBtns = section.querySelectorAll('[data-close]');

    if (!track) return;

    function getScrollAmount() {
      const firstCard = track.querySelector('.lux-reel-card');
      if (!firstCard) return 0;
      const styles = window.getComputedStyle(track);
      const gap = parseFloat(styles.columnGap || styles.gap || 16) || 16;
      return firstCard.offsetWidth + gap;
    }

    function syncNavButtons() {
      if (!track) return;

      const maxScrollLeft = Math.max(0, track.scrollWidth - track.clientWidth);
      const current = Math.ceil(track.scrollLeft);

      if (btnPrev) {
        btnPrev.classList.toggle('is-disabled', current <= 2);
      }

      if (btnNext) {
        btnNext.classList.toggle('is-disabled', current >= (maxScrollLeft - 2));
      }
    }

    if (btnNext) {
      btnNext.addEventListener('click', function (event) {
        event.stopPropagation();
        track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
      });
    }

    if (btnPrev) {
      btnPrev.addEventListener('click', function (event) {
        event.stopPropagation();
        track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
      });
    }

    track.addEventListener('scroll', syncNavButtons, { passive: true });
    window.addEventListener('resize', syncNavButtons);
    syncNavButtons();

    function formatTime(seconds) {
      const safe = Number.isFinite(seconds) ? Math.max(0, Math.floor(seconds)) : 0;
      const mins = Math.floor(safe / 60);
      const secs = safe % 60;
      return mins + ':' + String(secs).padStart(2, '0');
    }

    function updateVideoState(modal) {
      if (!modal) return;

      const video = modal.querySelector('.lux-modal-video');
      if (!video) return;

      const progressFill = modal.querySelector('[data-video-progress]');
      const timeLabel = modal.querySelector('[data-video-time]');
      const playBtn = modal.querySelector('[data-video-toggle]');
      const soundBtn = modal.querySelector('[data-video-sound]');

      if (progressFill) {
        const duration = video.duration || 0;
        const current = video.currentTime || 0;
        const progress = duration > 0 ? (current / duration) * 100 : 0;
        progressFill.style.width = progress + '%';
      }

      if (timeLabel) {
        timeLabel.textContent = formatTime(video.currentTime || 0) + ' / ' + formatTime(video.duration || 0);
      }

      if (playBtn) {
        if (video.paused) {
          playBtn.classList.add('is-paused');
          playBtn.classList.remove('is-playing');
        } else {
          playBtn.classList.remove('is-paused');
          playBtn.classList.add('is-playing');
        }
      }

      if (soundBtn) {
        soundBtn.classList.toggle('is-muted', !!video.muted);
      }
    }

    function forceVideoSound(video) {
      if (!video) return;

      video.defaultMuted = false;
      video.muted = false;
      video.volume = 1;

      try { video.removeAttribute('muted'); } catch (e) {}
      try { video.setAttribute('playsinline', ''); } catch (e) {}
      try { video.setAttribute('webkit-playsinline', ''); } catch (e) {}
    }

    function forceVideoMuted(video) {
      if (!video) return;

      video.defaultMuted = true;
      video.muted = true;
      try { video.setAttribute('muted', 'muted'); } catch (e) {}
    }

    function pauseAllOpenVideos() {
      section.querySelectorAll('.lux-modal.is-open .lux-modal-video').forEach(function(video) {
        try { video.pause(); } catch (e) {}
      });
    }

    function closeModal(modal) {
      if (!modal) return;

      modal.classList.remove('is-open');
      document.body.style.overflow = '';

      const video = modal.querySelector('.lux-modal-video');
      if (video) {
        try { video.pause(); } catch (e) {}
        try { video.currentTime = 0; } catch (e) {}
        updateVideoState(modal);
      }
    }

    function openModal(modal) {
      if (!modal) return;

      pauseAllOpenVideos();

      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';

      const video = modal.querySelector('.lux-modal-video');
      if (!video) return;

      forceVideoSound(video);

      const playAttempt = video.play();

      if (playAttempt && typeof playAttempt.then === 'function') {
        playAttempt
          .then(function() {
            updateVideoState(modal);
          })
          .catch(function() {
            forceVideoMuted(video);
            const fallbackPlay = video.play();
            if (fallbackPlay && typeof fallbackPlay.catch === 'function') {
              fallbackPlay.catch(function(){});
            }
            updateVideoState(modal);
          });
      } else {
        updateVideoState(modal);
      }
    }

    cards.forEach(function(card) {
      card.addEventListener('click', function() {
        const modalId = card.getAttribute('data-modal-target');
        openModal(document.getElementById(modalId));
      });

      card.addEventListener('keydown', function(event) {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          const modalId = card.getAttribute('data-modal-target');
          openModal(document.getElementById(modalId));
        }
      });
    });

    closeBtns.forEach(function(btn) {
      btn.addEventListener('click', function(event) {
        event.stopPropagation();
        closeModal(this.closest('.lux-modal'));
      });
    });

    modals.forEach(function(modal) {
      const video = modal.querySelector('.lux-modal-video');
      const playBtn = modal.querySelector('[data-video-toggle]');
      const soundBtn = modal.querySelector('[data-video-sound]');

      if (!video) return;

      try { video.setAttribute('playsinline', ''); } catch (e) {}
      try { video.setAttribute('webkit-playsinline', ''); } catch (e) {}

      if (playBtn) {
        playBtn.addEventListener('click', function(event) {
          event.stopPropagation();

          if (video.paused) {
            const p = video.play();
            if (p && typeof p.catch === 'function') {
              p.catch(function(){});
            }
          } else {
            video.pause();
          }

          updateVideoState(modal);
        });
      }

      if (soundBtn) {
        soundBtn.addEventListener('click', function(event) {
          event.stopPropagation();

          if (video.muted) {
            forceVideoSound(video);
            const p = video.play();
            if (p && typeof p.catch === 'function') {
              p.catch(function() {
                forceVideoMuted(video);
                updateVideoState(modal);
              });
            }
          } else {
            forceVideoMuted(video);
          }

          updateVideoState(modal);
        });
      }

      video.addEventListener('timeupdate', function() {
        updateVideoState(modal);
      });

      video.addEventListener('loadedmetadata', function() {
        updateVideoState(modal);
      });

      video.addEventListener('play', function() {
        updateVideoState(modal);
      });

      video.addEventListener('pause', function() {
        updateVideoState(modal);
      });

      video.addEventListener('volumechange', function() {
        updateVideoState(modal);
      });

      updateVideoState(modal);
    });

    if (!section._luxEscHandler) {
      section._luxEscHandler = function(event) {
        if (event.key === 'Escape') {
          const openModalElement = section.querySelector('.lux-modal.is-open');
          if (openModalElement) closeModal(openModalElement);
        }
      };
      document.addEventListener('keydown', section._luxEscHandler);
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    initLuxReels('{{ section.id }}');
  });

  document.addEventListener('shopify:section:load', function(event) {
    if (event.detail.sectionId === '{{ section.id }}') {
      initLuxReels('{{ section.id }}');
    }
  });
</script>

