    #LuxReels-{{ section.id }} .lux-reel-player {
      width: min(100%, calc((100dvh - 260px) * 9 / 16));
      aspect-ratio: 9 / 16;
      height: auto;
      margin: 0 auto;
      border-radius: 12px;
      overflow: hidden;
    }

    #LuxReels-{{ section.id }} .lux-modal__close {
      top: 12px;
      right: 12px;
      background: rgba(255, 255, 255, 0.92);
    }

    #LuxReels-{{ section.id }} .lux-modal__info-col {
      padding: 24px 20px;
      overflow: visible;
      flex: 0 0 auto;
    }
  }

  @media (max-width: 768px) {
    #LuxReels-{{ section.id }} .lux-reels__wrapper {
      padding: 0 18px;
    }

