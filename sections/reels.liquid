      flex: 0 0 calc(70% - 8px);
    }

    #LuxReels-{{ section.id }} .lux-carousel-btn {
      display: flex;
      width: 38px;
      height: 38px;
      top: calc(50% - 6px);
      background: rgba(255, 255, 255, 0.96);
      border-color: rgba(0, 0, 0, 0.08);
    }

    #LuxReels-{{ section.id }} .lux-carousel-btn--prev {
      left: 4px;
    }

    #LuxReels-{{ section.id }} .lux-carousel-btn--next {
      right: 4px;
