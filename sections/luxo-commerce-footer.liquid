<footer class="luxo-footer">
  {%- if section.settings.show_newsletter -%}
    <div class="luxo-footer__newsletter luxo-container luxo-container--wide">
      <div>
        {%- if section.settings.newsletter_kicker != blank -%}
          <p class="luxo-kicker">{{ section.settings.newsletter_kicker | escape }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.copy != blank -%}<p>{{ section.settings.copy | escape }}</p>{%- endif -%}
      </div>
      {%- form 'customer', id: 'LuxoFooterNewsletter', class: 'luxo-footer__newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="luxo-footer__field">
          <label class="luxo-footer__label" for="LuxoFooterEmail-{{ section.id }}">Correo electrónico</label>
          <div class="luxo-footer__form">
            <input
              id="LuxoFooterEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              autocomplete="email"
              inputmode="email"
              placeholder="nombre@correo.com"
              {% if form.errors %}aria-invalid="true" aria-describedby="LuxoFooterMessage-{{ section.id }}"{% endif %}
              required
            >
            <button type="submit" name="commit">Unirme <span aria-hidden="true">→</span></button>
          </div>
          {%- if section.settings.newsletter_note != blank -%}
            <p class="luxo-footer__note">{{ section.settings.newsletter_note | escape }}</p>
          {%- endif -%}
        </div>
        {%- if form.errors -%}<p id="LuxoFooterMessage-{{ section.id }}" class="luxo-form-message" role="alert">Escribe un correo válido para continuar.</p>{%- endif -%}
        {%- if form.posted_successfully? -%}<p id="LuxoFooterMessage-{{ section.id }}" class="luxo-form-message luxo-form-message--success" role="status">Tu registro quedó confirmado.</p>{%- endif -%}
      {%- endform -%}
    </div>
  {%- endif -%}

  <div class="luxo-footer__main luxo-container luxo-container--wide">
    <div class="luxo-footer__brand">
      <a class="luxo-footer__logo" href="{{ routes.root_url }}">
        <img src="{{ 'luxo-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="300" height="58" loading="lazy">
      </a>
      {%- if section.settings.brand_copy != blank -%}<p>{{ section.settings.brand_copy | escape }}</p>{%- endif -%}

      {%- if section.settings.show_social -%}
        {% render 'social-icons', class: 'luxo-footer__social' %}
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'menu' -%}
          {%- if block.settings.menu != blank -%}
            <nav class="luxo-footer__menu" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.heading | escape }}</h3>
              <ul>
                {%- for link in block.settings.menu.links limit: 10 -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </nav>
          {%- endif -%}

        {%- when 'contact' -%}
          <div class="luxo-footer__menu luxo-footer__contact" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.heading | escape }}</h3>
            <ul>
              {%- if block.settings.email != blank -%}
                <li><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></li>
              {%- endif -%}
              {%- if block.settings.phone != blank -%}
                <li><a href="tel:{{ block.settings.phone | remove: ' ' | remove: '-' }}">{{ block.settings.phone }}</a></li>
              {%- endif -%}
              {%- if block.settings.whatsapp != blank -%}
                <li><a href="{{ block.settings.whatsapp }}" rel="noopener">WhatsApp</a></li>
              {%- endif -%}
              {%- if block.settings.schedule != blank -%}
                <li><span>{{ block.settings.schedule | escape }}</span></li>
              {%- endif -%}
              {%- if block.settings.address != blank -%}
                <li><span>{{ block.settings.address | escape }}</span></li>
              {%- endif -%}
            </ul>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.show_reassurance -%}
    <div class="luxo-footer__reassurance luxo-container luxo-container--wide">
      {%- if section.settings.reassurance_1 != blank -%}<span>{{ section.settings.reassurance_1 | escape }}</span>{%- endif -%}
      {%- if section.settings.reassurance_2 != blank -%}<span>{{ section.settings.reassurance_2 | escape }}</span>{%- endif -%}
      {%- if section.settings.reassurance_3 != blank -%}<span>{{ section.settings.reassurance_3 | escape }}</span>{%- endif -%}
    </div>
  {%- endif -%}

  <div class="luxo-footer__bottom luxo-container luxo-container--wide">
    <span class="luxo-footer__copy">© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span>

    <div class="luxo-footer__policies">
      {%- for policy in shop.policies -%}
        {%- if policy != blank -%}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <div class="luxo-footer__payments" role="list" aria-label="Métodos de pago aceptados">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'luxo-footer__payment-icon' }}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</footer>

{% style %}
  .luxo-footer {
    color: var(--luxo-ink);
    background: #e4dfd8;
  }

  .luxo-footer__newsletter {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.8fr);
    align-items: center;
    gap: 6vw;
    padding-top: clamp(44px, 5vw, 72px);
    padding-bottom: clamp(40px, 4.5vw, 64px);
    border-bottom: 1px solid var(--luxo-line);
  }

  .luxo-footer__newsletter h2 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(2.8rem, 3.2vw, 4.8rem);
    line-height: 1;
  }

  .luxo-footer__newsletter > div > p:last-child {
    max-width: 46ch;
    margin: 12px 0 0;
    color: var(--luxo-ink-soft);
    font-size: 1.25rem;
    line-height: 1.55;
  }

  .luxo-footer__note {
    margin: 10px 0 0;
    color: var(--luxo-ink-soft);
    font-size: 1.1rem;
    line-height: 1.5;
  }

  .luxo-footer__logo { display: inline-block; line-height: 0; }
  .luxo-footer__logo img { display: block; width: min(230px, 100%); height: auto; }

  .luxo-footer__main {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 0.7fr));
    gap: 48px 5vw;
    padding-top: clamp(40px, 4vw, 58px);
    padding-bottom: clamp(36px, 4vw, 54px);
  }

  .luxo-footer__brand p {
    max-width: 42ch;
    margin: 18px 0 0;
    color: var(--luxo-ink-soft);
    font-size: 1.3rem;
    line-height: 1.6;
  }

  .luxo-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }

  .luxo-footer__social .list-social__link {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid var(--luxo-line);
    border-radius: 50%;
    color: var(--luxo-ink);
    transition: color 200ms ease, background 200ms ease, border-color 200ms ease;
  }

  .luxo-footer__social .list-social__link:hover {
    color: var(--luxo-white);
    border-color: var(--luxo-ink);
    background: var(--luxo-ink);
  }

  .luxo-footer__social .svg-wrapper,
  .luxo-footer__social svg { width: 17px; height: 17px; }

  .luxo-footer__menu h3 {
    margin: 0 0 16px;
    color: var(--luxo-ink-soft);
    font-family: var(--luxo-font) !important;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .luxo-footer__menu ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .luxo-footer__menu a,
  .luxo-footer__menu span {
    display: inline-block;
    min-height: 26px;
    color: var(--luxo-ink);
    font-size: 1.25rem;
    line-height: 1.5;
    text-decoration: none;
  }

  .luxo-footer__menu a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .luxo-footer__contact span { color: var(--luxo-ink-soft); }

  .luxo-footer__reassurance {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 42px;
    padding-block: 20px;
    border-top: 1px solid var(--luxo-line);
    color: var(--luxo-ink-soft);
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .luxo-footer__bottom {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px 32px;
    padding-block: 20px 26px;
    border-top: 1px solid var(--luxo-line);
    color: var(--luxo-ink-soft);
    font-size: 1.15rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .luxo-footer__policies {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 22px;
  }

  .luxo-footer__policies a {
    min-height: 26px;
    color: inherit;
    text-decoration: none;
  }

  .luxo-footer__policies a:hover { text-decoration: underline; text-underline-offset: 4px; }

  .luxo-footer__payments {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 7px;
  }

  .luxo-footer__payment-icon {
    width: 38px;
    height: 24px;
    border-radius: 3px;
  }

  @media screen and (max-width: 1100px) {
    .luxo-footer__main { grid-template-columns: minmax(0, 1.2fr) repeat(3, minmax(0, 1fr)); gap: 40px 32px; }
  }

  @media screen and (max-width: 899px) {
    .luxo-footer__newsletter { grid-template-columns: 1fr; gap: 26px; }
    .luxo-footer__main { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .luxo-footer__brand { grid-column: 1 / -1; }
    .luxo-footer__bottom { grid-template-columns: 1fr; text-align: left; }
    .luxo-footer__policies,
    .luxo-footer__payments { justify-content: flex-start; }
  }

  @media screen and (max-width: 560px) {
    .luxo-footer__main { grid-template-columns: 1fr; gap: 34px; }
    .luxo-footer__reassurance { gap: 10px 22px; font-size: 1rem; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Luxo footer",
  "settings": [
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Mostrar newsletter", "default": true },
    { "type": "text", "id": "newsletter_kicker", "label": "Antetítulo", "default": "ACCESO LUXO" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Acceso anticipado." },
    { "type": "text", "id": "copy", "label": "Texto de newsletter", "default": "Lanzamientos, guías de talla y selecciones para tu rutina." },
    { "type": "text", "id": "newsletter_note", "label": "Nota legal", "default": "Al suscribirte aceptas recibir correos de Luxo. Puedes darte de baja cuando quieras." },
    { "type": "header", "content": "Marca" },
    { "type": "text", "id": "brand_copy", "label": "Descripción de marca", "default": "Fajas, moda y bienestar elegidos para acompañar tu cuerpo y tu vida." },
    { "type": "checkbox", "id": "show_social", "label": "Mostrar redes sociales", "info": "Los enlaces se configuran en Configuración del tema › Redes sociales.", "default": true },
    { "type": "header", "content": "Franja de confianza" },
    { "type": "checkbox", "id": "show_reassurance", "label": "Mostrar franja de confianza", "default": true },
    { "type": "text", "id": "reassurance_1", "label": "Texto 1", "default": "ENVÍOS A TODO EE. UU." },
    { "type": "text", "id": "reassurance_2", "label": "Texto 2", "default": "CAMBIOS ACOMPAÑADOS" },
    { "type": "text", "id": "reassurance_3", "label": "Texto 3", "default": "PAGO PROTEGIDO" },
    { "type": "header", "content": "Base" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Mostrar métodos de pago", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menú",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "COMPRAR" },
        { "type": "link_list", "id": "menu", "label": "Menú", "default": "footer" }
      ]
    },
    {
      "type": "contact",
      "name": "Contacto",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "CONTACTO" },
        { "type": "text", "id": "email", "label": "Correo" },
        { "type": "text", "id": "phone", "label": "Teléfono" },
        { "type": "url", "id": "whatsapp", "label": "Enlace de WhatsApp" },
        { "type": "text", "id": "schedule", "label": "Horario" },
        { "type": "text", "id": "address", "label": "Dirección" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Luxo footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "COMPRAR" } },
        { "type": "menu", "settings": { "heading": "AYUDA" } },
        { "type": "contact" }
      ]
    }
  ]
}
{% endschema %}
