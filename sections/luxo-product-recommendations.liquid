{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<product-recommendations
  class="luxo-recommendations luxo-section"
  style="--luxo-cols: {{ section.settings.columns | default: 4 }};"
  data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="luxo-container luxo-container--wide">
      <div class="luxo-recommendations__head">
        <div>
          <p class="luxo-kicker">{{ section.settings.kicker | escape }}</p>
          <h2>{{ section.settings.heading | escape }}</h2>
        </div>
        <a href="{{ routes.all_products_collection_url }}">Ver toda la selección <span aria-hidden="true">↗</span></a>
      </div>
      <ul class="luxo-recommendations__grid" role="list">
        {%- for recommendation in recommendations.products limit: section.settings.products_to_show -%}
          <li>{% render 'luxo-product-card', product: recommendation %}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Luxo recomendaciones",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "MEJOR JUNTAS" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Completa tu look" },
    { "type": "range", "id": "products_to_show", "label": "Productos", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Columnas en escritorio", "min": 2, "max": 5, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Luxo recomendaciones" }]
}
{% endschema %}
