<script>
(function () {
  function initJoanaBday(sectionId) {
    var section = document.getElementById('JoanaBday-' + sectionId);
    if (!section) return;

    section.querySelectorAll('[data-product-card]').forEach(function (card) {
      var mainImage    = card.querySelector('[data-main-image]');
      var variantInput = card.querySelector('[data-variant-input]');
      var priceWrap    = card.querySelector('[data-price-wrap]');
      var currentPrice = card.querySelector('[data-price-current]');
      var comparePrice = card.querySelector('[data-price-compare]');
      var variantLabel = card.querySelector('[data-variant-label]');
      var atcButton    = card.querySelector('[data-atc-button]');
      var productLinks = card.querySelectorAll('[data-product-link]');
      var triggers     = card.querySelectorAll('[data-variant-trigger]');

      triggers.forEach(function (trigger) {
        trigger.addEventListener('click', function () {
          var id          = this.dataset.variantId || '';
          var imgSrc      = this.dataset.imageSrc || '';
          var imgSrcset   = this.dataset.imageSrcset || '';
          var price       = this.dataset.price || '';
          var compare     = this.dataset.comparePrice || '';
          var title       = this.dataset.variantTitle || '';
          var url         = this.dataset.variantUrl || '#';
          var available   = this.dataset.available === 'true';

          triggers.forEach(function (t) {
            t.classList.toggle('active', t.dataset.variantId === id);
          });

          if (mainImage && imgSrc) {
            mainImage.src = imgSrc;
            if (imgSrcset) mainImage.srcset = imgSrcset;
            if (title) mainImage.alt = title;
          }
          if (variantInput && id) variantInput.value = id;
          if (currentPrice) currentPrice.textContent = price;
          if (comparePrice && priceWrap) {
            if (compare && compare.trim() !== '') {
              comparePrice.textContent = compare;
              comparePrice.classList.remove('is-hidden');
              priceWrap.classList.add('is-on-sale');
            } else {
              comparePrice.textContent = '';
              comparePrice.classList.add('is-hidden');
              priceWrap.classList.remove('is-on-sale');
            }
          }
          if (variantLabel) {
            if (title && title !== 'Default Title') {
              variantLabel.textContent = title;
              variantLabel.classList.remove('is-hidden');
            } else {
              variantLabel.textContent = '';
              variantLabel.classList.add('is-hidden');
            }
          }
          productLinks.forEach(function (link) { link.setAttribute('href', url); });
          if (atcButton) {
            atcButton.disabled = !available;
            atcButton.classList.toggle('joana-bday-btn--disabled', !available);
            atcButton.textContent = available
              ? {{ section.settings.add_to_cart_label | json }}
              : {{ section.settings.badge_soldout | json }};
          }
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', function () { initJoanaBday('{{ section.id }}'); });
  document.addEventListener('shopify:section:load', function (e) {
    if (e.detail && e.detail.sectionId === '{{ section.id }}') initJoanaBday('{{ section.id }}');
  });
})();
</script>

