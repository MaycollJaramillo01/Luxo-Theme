        "custom_liquid": "<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Poppins:wght@400;600;700&display=swap');\n  \n  .luxo-custom-section{\n    position:relative;\n    width:100%;\n    overflow:hidden;\n    display:flex;\n    flex-direction:column;\n    font-family:'Poppins',sans-serif;\n  }\n\n  \/* --- Banner wrapper: altura automática = sin recortes --- *\/\n  .luxo-banner-wrapper{\n    position:relative;\n    display:block;\n    width:100%;\n  }\n\n  \/* Imagen completa sin crop *\/\n  .luxo-banner-image{\n    width:100%;\n    height:auto;\n    display:block;\n  }\n\n  \/* Botón superpuesto *\/\n  .luxo-button{\n    position:absolute;\n    left: 38%;\n    bottom: 12%;\n    transform: translateX(-50%);\n    background-color:#ffffff;\n    color:#000000;\n    padding: 12px 32px;\n    border-radius: 30px;\n    font-weight:700;\n    font-size:14px;\n    text-decoration:none;\n    text-transform:uppercase;\n    letter-spacing:.5px;\n    box-shadow:0 4px 12px rgba(0,0,0,.15);\n    transition: all .3s ease;\n    z-index:2;\n    white-space:nowrap;\n  }\n  .luxo-button:hover{\n    background-color:#f4f4f4;\n    transform: translateX(-50%) scale(1.03);\n    box-shadow:0 6px 15px rgba(0,0,0,.2);\n  }\n\n  \/* --- Carrusel (Marquee) --- *\/\n  .luxo-marquee-container{\n    background-color:#fd9bc9;\n    color:#ffffff;\n    padding:12px 0;\n    display:flex;\n    overflow:hidden;\n    white-space:nowrap;\n    position:relative;\n    width:100%;\n  }\n  .luxo-marquee-track{\n    display:flex;\n    width:fit-content;\n    animation: scrollMarquee 25s linear infinite;\n  }\n  .luxo-marquee-track:hover{ animation-play-state: paused; }\n  .luxo-marquee-content{\n    display:flex;\n    flex-shrink:0;\n  }\n  .luxo-marquee-item{\n    font-weight:600;\n    font-size:14px;\n    padding:0 40px;\n  }\n  @keyframes scrollMarquee{\n    0%{ transform: translateX(0); }\n    100%{ transform: translateX(-50%); }\n  }\n\n  \/* --- Móvil --- *\/\n  @media screen and (max-width: 768px){\n    .luxo-button{\n      left:50%;\n      bottom:8%;\n      padding:10px 24px;\n      font-size:12px;\n    }\n    .luxo-marquee-item{\n      font-size:13px;\n      padding:0 20px;\n    }\n  }\n<\/style>\n\n<div class=\"luxo-custom-section\">\n  <div class=\"luxo-banner-wrapper\">\n    <a href=\"https:\/\/www.luxoboutique.com\/collections\/fajas-body-invisibles\" aria-label=\"Ver colección\">\n      <picture>\n        <!-- Imagen para móvil -->\n        <source\n          media=\"(max-width: 768px)\"\n          srcset=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0483\/6697\/7184\/files\/IMG_5255.jpg?v=1774458712\">\n        <!-- Imagen para desktop (completa) -->\n        <img\n          src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0483\/6697\/7184\/files\/IMG_5243_1.png?v=1774451846\"\n          alt=\"Marzo, un mes para celebrar su fuerza, seguridad y poder\"\n          class=\"luxo-banner-image\"\n          loading=\"lazy\">\n      <\/picture>\n    <\/a>\n    <a href=\"https:\/\/www.luxoboutique.com\/collections\/fajas-body-invisibles\" class=\"luxo-button\">\n      VER PRODUCTOS\n    <\/a>\n  <\/div>\n\n   <!-- Imagen para móvil\n<div class=\"luxo-marquee-container\">\n    <div class=\"luxo-marquee-track\">\n      <div class=\"luxo-marquee-content\">\n        <span class=\"luxo-marquee-item\">20% OFF Productos de Belleza<\/span>\n        <span class=\"luxo-marquee-item\">20% OFF Productos para Adelgazar<\/span>\n        <span class=\"luxo-marquee-item\">20% OFF En toda la Tienda<\/span>\n        <span class=\"luxo-marquee-item\">20% OFF Fajas Moldeadoras<\/span>\n      <\/div>\n      <div class=\"luxo-marquee-content\" aria-hidden=\"true\">\n        <span class=\"luxo-marquee-item\">20% OFF Productos de Belleza<\/span>\n        <span class=\"luxo-marquee-item\">20% OFF Productos para Adelgazar<\/span>\n        <span class=\"luxo-marquee-item\">20% OFF En toda la Tienda<\/span>\n        <span class=\"luxo-marquee-item\">20% OFF Fajas Moldeadoras<\/