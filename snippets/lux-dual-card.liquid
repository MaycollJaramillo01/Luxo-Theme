{% comment %}
  Snippet: lux-dual-card.liquid
  Maneja la tarjeta individual del diseño dual con contraste calculado.
{% endcomment %}

<div class="lux-dual-column" style="--card-op: {{ op | divided_by: 100.0 }};">
  <a href="{{ prod.url }}" style="display:block; height:100%; width:100%; text-decoration:none;">
    {%- if prod.featured_media -%}
      {% comment %} Atributos width y height dinámicos para evitar errores de carga {% endcomment %}
      <img 
        src="{{ prod.featured_media | image_url: width: 1500 }}" 
        alt="{{ prod.title | escape }}"
        loading="lazy"
        width="{{ prod.featured_media.width }}"
        height="{{ prod.featured_media.height }}"
        class="lux-dual-img-asset">
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'lux-dual-img-asset' }}
    {%- endif -%}
    
    <div class="lux-dual-overlay-layer">
      {% comment %} 
         Tomamos la primera palabra del título para el look 'Leonisa' (Ej: SLIMMING). 
         Si prefieres el título completo, borra: | split: ' ' | first 
      {% endcomment %}
      <h3 class="lux-dual-product-text">
        {{ prod.title | split: ' ' | first }}
      </h3>
    </div>
  </a>
</div>